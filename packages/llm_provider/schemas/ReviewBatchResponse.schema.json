{
  "additionalProperties": false,
  "properties": {
    "accepted_medical_evidence": {
      "const": false,
      "default": false,
      "title": "Accepted Medical Evidence",
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    },
    "finish_reason": {
      "anyOf": [
        {
          "enum": [
            "stop",
            "length",
            "content_filter",
            "tool_calls",
            "function_call"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finish Reason"
    },
    "raw_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Checksum",
      "type": "string"
    },
    "raw_model_text": {
      "maxLength": 262144,
      "title": "Raw Model Text",
      "type": "string"
    },
    "record_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Record Checksum",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "review-batch-response/1.0.0",
      "default": "review-batch-response/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "untrusted_model_output": {
      "const": true,
      "default": true,
      "title": "Untrusted Model Output",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "record_checksum",
    "raw_model_text",
    "raw_checksum",
    "error",
    "finish_reason"
  ],
  "title": "ReviewBatchResponse",
  "type": "object"
}
