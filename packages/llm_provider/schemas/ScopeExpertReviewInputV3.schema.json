{
  "$defs": {
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RegionScopeV2": {
      "additionalProperties": false,
      "description": "Bounded full descriptions; visibility and numeric invariants unchanged.",
      "properties": {
        "clarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "finding": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "limitation": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Limitation",
          "type": "string"
        },
        "region": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Region",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "visible",
            "partly_visible",
            "not_identified",
            "uncertain"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "region",
        "visibility",
        "coverage",
        "clarity",
        "finding",
        "limitation"
      ],
      "title": "RegionScopeV2",
      "type": "object"
    },
    "ScopeVisionProposalV3": {
      "additionalProperties": false,
      "description": "Explicit local text-capacity interpretation, not an old wire relaxation.",
      "properties": {
        "finding": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "image_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Checksum",
          "type": "string"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "preprocessing_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preprocessing Checksum",
          "type": "string"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionScopeV2"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Regions",
          "type": "array"
        },
        "schema_version": {
          "const": "visual-input-scope-candidate/1.2.0",
          "default": "visual-input-scope-candidate/1.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "image_checksum",
        "preprocessing_checksum",
        "location",
        "status",
        "finding",
        "regions"
      ],
      "title": "ScopeVisionProposalV3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_set_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Action Set Checksum",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/ScopeVisionProposalV3"
    },
    "event": {
      "$ref": "#/$defs/Reference"
    },
    "policy_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Checksum",
      "type": "string"
    },
    "proposal_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Proposal Checksum",
      "type": "string"
    },
    "proposed_action_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Proposed Action Id",
      "type": "string"
    },
    "schema_version": {
      "const": "input-scope-expert-review/1.2.0",
      "default": "input-scope-expert-review/1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "triggers": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "title": "Triggers",
      "type": "array"
    }
  },
  "required": [
    "event",
    "proposal_checksum",
    "proposed_action_id",
    "action_set_checksum",
    "policy_checksum",
    "triggers",
    "candidate"
  ],
  "title": "ScopeExpertReviewInputV3",
  "type": "object"
}
