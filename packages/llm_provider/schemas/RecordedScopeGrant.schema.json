{
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Authorization",
      "type": "string"
    },
    "case_code": {
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
      "title": "Case Code",
      "type": "string"
    },
    "control_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Control Checksum",
      "type": "string"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "failed_phase_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Failed Phase Checksum",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "new_api_requests": {
      "const": 0,
      "default": 0,
      "title": "New Api Requests",
      "type": "integer"
    },
    "new_disease_scores": {
      "const": 0,
      "default": 0,
      "title": "New Disease Scores",
      "type": "integer"
    },
    "original_grant_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Grant Checksum",
      "type": "string"
    },
    "original_request_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Original Request Checksum",
      "type": "string"
    },
    "purpose": {
      "const": "save_confirmed_scope_storage_only",
      "default": "save_confirmed_scope_storage_only",
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "maxLength": 256,
      "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "recorded-input-scope-grant/1.0.0",
      "default": "recorded-input-scope-grant/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Checksum",
      "type": "string"
    },
    "submission_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Submission Checksum",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "case_code",
    "original_grant_checksum",
    "failed_phase_checksum",
    "control_checksum",
    "state_checksum",
    "submission_checksum",
    "original_request_checksum",
    "authorization",
    "issued_at",
    "deadline"
  ],
  "title": "RecordedScopeGrant",
  "type": "object"
}
