{
  "$defs": {
    "PassagePlan": {
      "additionalProperties": false,
      "description": "Public, local-only recall plan; each alternative still uses original FTS.",
      "properties": {
        "context_radius": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Context Radius",
          "type": "integer"
        },
        "max_characters": {
          "default": 12000,
          "maximum": 16000,
          "minimum": 1000,
          "title": "Max Characters",
          "type": "integer"
        },
        "max_per_document": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Max Per Document",
          "type": "integer"
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "schema_version": {
          "const": "definition-passage-plan/1.0.0",
          "default": "definition-passage-plan/1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "queries"
      ],
      "title": "PassagePlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "direction_policy": {
      "const": "direction-assessment/1.0.0",
      "default": "direction-assessment/1.0.0",
      "title": "Direction Policy",
      "type": "string"
    },
    "index_keys": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Index Keys",
      "type": "array"
    },
    "material_policy": {
      "const": "xml-jats-whole-text/1.0.0",
      "default": "xml-jats-whole-text/1.0.0",
      "title": "Material Policy",
      "type": "string"
    },
    "max_candidates": {
      "default": 5,
      "maximum": 5,
      "minimum": 1,
      "title": "Max Candidates",
      "type": "integer"
    },
    "max_definitions": {
      "const": 1,
      "default": 1,
      "title": "Max Definitions",
      "type": "integer"
    },
    "max_fetch_requests": {
      "default": 2,
      "maximum": 2,
      "minimum": 1,
      "title": "Max Fetch Requests",
      "type": "integer"
    },
    "max_new_observations": {
      "const": 1,
      "default": 1,
      "title": "Max New Observations",
      "type": "integer"
    },
    "max_operations": {
      "default": 24,
      "maximum": 24,
      "minimum": 1,
      "title": "Max Operations",
      "type": "integer"
    },
    "max_rounds": {
      "const": 1,
      "default": 1,
      "title": "Max Rounds",
      "type": "integer"
    },
    "max_search_requests": {
      "default": 2,
      "maximum": 2,
      "minimum": 1,
      "title": "Max Search Requests",
      "type": "integer"
    },
    "passage_plans": {
      "additionalProperties": {
        "$ref": "#/$defs/PassagePlan"
      },
      "maxProperties": 2,
      "minProperties": 1,
      "title": "Passage Plans",
      "type": "object"
    },
    "prompt_version": {
      "const": "definition-draft-3.0.0",
      "default": "definition-draft-3.0.0",
      "title": "Prompt Version",
      "type": "string"
    },
    "public_queries": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Public Queries",
      "type": "array"
    },
    "public_target": {
      "title": "Public Target",
      "type": "string"
    },
    "public_topic_sets": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "maxProperties": 2,
      "minProperties": 1,
      "title": "Public Topic Sets",
      "type": "object"
    },
    "public_topics": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 3,
      "title": "Public Topics",
      "type": "object"
    },
    "query_requirements": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "maxProperties": 3,
      "title": "Query Requirements",
      "type": "object"
    },
    "require_target_relation": {
      "const": true,
      "default": true,
      "title": "Require Target Relation",
      "type": "boolean"
    },
    "reserve_close_seconds": {
      "default": 300,
      "maximum": 900,
      "minimum": 60,
      "title": "Reserve Close Seconds",
      "type": "integer"
    },
    "reserve_review_requests": {
      "default": 12,
      "maximum": 30,
      "minimum": 1,
      "title": "Reserve Review Requests",
      "type": "integer"
    },
    "schema_version": {
      "const": "campaign-definition-expansion/1.10.0",
      "default": "campaign-definition-expansion/1.10.0",
      "title": "Schema Version",
      "type": "string"
    },
    "search_failure_policy": {
      "const": "technical_backlog_no_retry",
      "default": "technical_backlog_no_retry",
      "title": "Search Failure Policy",
      "type": "string"
    },
    "search_timeout_ms": {
      "default": 120000,
      "maximum": 120000,
      "minimum": 30000,
      "title": "Search Timeout Ms",
      "type": "integer"
    },
    "source_output_tokens": {
      "const": 8192,
      "default": 8192,
      "title": "Source Output Tokens",
      "type": "integer"
    }
  },
  "required": [
    "index_keys",
    "public_queries",
    "public_topic_sets",
    "passage_plans",
    "public_target"
  ],
  "title": "CapacityExpansionPolicy",
  "type": "object"
}
