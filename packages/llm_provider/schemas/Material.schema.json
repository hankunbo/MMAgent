{
  "$defs": {
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "ImageBinding": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "pixel_xy_top_left",
          "title": "Coordinate System",
          "type": "string"
        },
        "height": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "preprocessing": {
          "$ref": "#/$defs/Reference"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "width": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "reference",
        "media_type",
        "width",
        "height",
        "coordinate_system",
        "preprocessing",
        "location"
      ],
      "title": "ImageBinding",
      "type": "object"
    },
    "ObservationInput": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "status": {
          "enum": [
            "obtained",
            "missing",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "reference",
        "status",
        "method",
        "unit",
        "value"
      ],
      "title": "ObservationInput",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Case Code",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "material_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Run Id",
          "type": "string"
        },
        "visible_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Visible Checksum",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "published_evidence",
            "research_material"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "published",
            "research_only"
          ],
          "title": "State",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "locator",
        "purpose",
        "state",
        "text"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Installed reader grants visibility; a checksum alone is never authorization.",
  "properties": {
    "goal_code": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Goal Code",
      "type": "string"
    },
    "goal_summary": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Goal Summary",
      "type": "string"
    },
    "memory": {
      "default": [],
      "maxItems": 0,
      "minItems": 0,
      "title": "Memory",
      "type": "array"
    },
    "missing": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Missing",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ObservationInput"
      },
      "maxItems": 128,
      "title": "Observations",
      "type": "array"
    },
    "policy_ref": {
      "$ref": "#/$defs/Reference"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "maxItems": 16,
      "title": "Sources",
      "type": "array"
    },
    "visibility": {
      "const": "approved_visible_projection/1.0.0",
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "goal_code",
    "goal_summary",
    "visibility",
    "sources",
    "observations",
    "policy_ref",
    "missing"
  ],
  "title": "Material",
  "type": "object"
}
