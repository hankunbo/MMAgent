{
  "$defs": {
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "Judgment": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "method": {
          "enum": [
            "manual_source_bound_review",
            "fixed_model_margin",
            "not_assessed"
          ],
          "title": "Method",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "lower",
        "upper",
        "reason",
        "method"
      ],
      "title": "Judgment",
      "type": "object"
    },
    "PartialObservation": {
      "additionalProperties": false,
      "description": "Task-relative estimates, not image measurements or calibrated risks.",
      "properties": {
        "basis": {
          "enum": [
            "disc_arc",
            "cup_disc_boundaries",
            "retinal_roi",
            "vessel_segments"
          ],
          "title": "Basis",
          "type": "string"
        },
        "basis_detail": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "clarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "signal": {
          "enum": [
            "present",
            "absent_in_visible_region",
            "indeterminate"
          ],
          "title": "Signal",
          "type": "string"
        },
        "unseen": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Unseen",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "visible": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Visible",
          "type": "string"
        }
      },
      "required": [
        "coverage",
        "clarity",
        "basis",
        "basis_detail",
        "visible",
        "unseen",
        "signal",
        "estimate",
        "lower",
        "upper"
      ],
      "title": "PartialObservation",
      "type": "object"
    },
    "PartialVisionProposal": {
      "additionalProperties": false,
      "properties": {
        "finding": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "image_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Checksum",
          "type": "string"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "partial": {
          "$ref": "#/$defs/PartialObservation"
        },
        "preprocessing_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preprocessing Checksum",
          "type": "string"
        },
        "schema_version": {
          "const": "visual-observation-candidate/2.0.0",
          "default": "visual-observation-candidate/2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "image_checksum",
        "preprocessing_checksum",
        "location",
        "status",
        "finding",
        "partial"
      ],
      "title": "PartialVisionProposal",
      "type": "object"
    },
    "Rating": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "title": "Rating",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Rating"
        },
        "assessment_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "comparison": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Comparison",
          "type": "string"
        },
        "judgment": {
          "$ref": "#/$defs/Judgment"
        },
        "limitation_allocation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Limitation Allocation",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Rating"
        },
        "observation_available": {
          "title": "Observation Available",
          "type": "boolean"
        },
        "observation_citations": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Observation Citations",
          "type": "array"
        },
        "reference_citations": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reference Citations",
          "type": "array"
        },
        "relation": {
          "$ref": "#/$defs/Rating"
        },
        "status": {
          "enum": [
            "assessed",
            "reference_missing",
            "method_mismatch",
            "context_only",
            "observation_ungradable",
            "input_missing",
            "intermediate"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "status",
        "observation_available",
        "observation_citations",
        "reference_citations",
        "comparison",
        "observation",
        "relation",
        "applicability",
        "judgment",
        "limitation_allocation",
        "unresolved"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "ReviewProposal": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "round": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Round",
          "type": "string"
        },
        "schema_version": {
          "const": "research-review-candidate/1.0.0",
          "default": "research-review-candidate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "round",
        "items"
      ],
      "title": "ReviewProposal",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Case Code",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "material_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Run Id",
          "type": "string"
        },
        "visible_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Visible Checksum",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SourceProposal": {
      "additionalProperties": false,
      "properties": {
        "missing": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Missing",
          "type": "array"
        },
        "quote": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "reason": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "relation": {
          "enum": [
            "requires",
            "organizes",
            "derived_from",
            "research_association"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "const": "research-relation-candidate/1.0.0",
          "default": "research-relation-candidate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "source_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Source Code",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "source_code",
        "quote",
        "target",
        "relation",
        "missing",
        "reason"
      ],
      "title": "SourceProposal",
      "type": "object"
    },
    "VisionProposal": {
      "additionalProperties": false,
      "properties": {
        "finding": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "image_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Checksum",
          "type": "string"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "preprocessing_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preprocessing Checksum",
          "type": "string"
        },
        "schema_version": {
          "const": "visual-observation-candidate/1.0.0",
          "default": "visual-observation-candidate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "image_checksum",
        "preprocessing_checksum",
        "location",
        "status",
        "finding"
      ],
      "title": "VisionProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "const": "PLANNER",
      "title": "Actor",
      "type": "string"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewProposal"
        },
        {
          "$ref": "#/$defs/SourceProposal"
        },
        {
          "$ref": "#/$defs/PartialVisionProposal"
        },
        {
          "$ref": "#/$defs/VisionProposal"
        }
      ],
      "title": "Candidate"
    },
    "config_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Checksum",
      "type": "string"
    },
    "correlation": {
      "const": "SOURCE:AGENT_RESEARCH",
      "title": "Correlation",
      "type": "string"
    },
    "observation_checksums": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "Observation Checksums",
      "type": "array"
    },
    "prompt_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Checksum",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "research-submission/1.0.0",
      "default": "research-submission/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source_checksums": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "Source Checksums",
      "type": "array"
    },
    "status": {
      "const": "candidate_not_accepted",
      "default": "candidate_not_accepted",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scope",
    "actor",
    "correlation",
    "request_id",
    "prompt_checksum",
    "config_checksum",
    "observation_checksums",
    "source_checksums",
    "candidate"
  ],
  "title": "Submission",
  "type": "object"
}
