{
  "$defs": {
    "AliasProjection": {
      "additionalProperties": false,
      "properties": {
        "current_manifest_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Current Manifest Checksum",
          "type": "string"
        },
        "medical_values_and_explanation_unchanged": {
          "const": true,
          "default": true,
          "title": "Medical Values And Explanation Unchanged",
          "type": "boolean"
        },
        "original_manifest_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Manifest Checksum",
          "type": "string"
        },
        "projected_candidate_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Projected Candidate Checksum",
          "type": "string"
        },
        "projected_state_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Projected State Checksum",
          "type": "string"
        },
        "schema_version": {
          "const": "accepted-source-alias-projection/1.0.0",
          "default": "accepted-source-alias-projection/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "transfers": {
          "items": {
            "$ref": "#/$defs/AliasTransfer"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Transfers",
          "type": "array"
        }
      },
      "required": [
        "original_manifest_checksum",
        "current_manifest_checksum",
        "transfers",
        "projected_state_checksum",
        "projected_candidate_checksum"
      ],
      "title": "AliasProjection",
      "type": "object"
    },
    "AliasTransfer": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/Reference"
        },
        "before": {
          "$ref": "#/$defs/Reference"
        },
        "original": {
          "$ref": "#/$defs/Reference"
        },
        "source_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Checksum",
          "type": "string"
        }
      },
      "required": [
        "original",
        "before",
        "after",
        "source_checksum"
      ],
      "title": "AliasTransfer",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Acceptance Checksum",
      "type": "string"
    },
    "acceptance_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Acceptance Key",
      "type": "string"
    },
    "alias_projection": {
      "$ref": "#/$defs/AliasProjection"
    },
    "control_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Control Checksum",
      "type": "string"
    },
    "item_requests": {
      "maxProperties": 64,
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        }
      },
      "title": "Item Requests",
      "type": "object"
    },
    "journal_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Journal Checksum",
      "type": "string"
    },
    "permission_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Permission Checksum"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "state_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Checksum",
      "type": "string"
    },
    "submission_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Submission Checksum",
      "type": "string"
    },
    "unused_request_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "title": "Unused Request Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "acceptance_key",
    "acceptance_checksum",
    "submission_checksum",
    "state_checksum",
    "control_checksum",
    "journal_checksum",
    "permission_checksum",
    "item_requests",
    "unused_request_ids",
    "alias_projection"
  ],
  "title": "AliasAcceptedOrigin",
  "type": "object"
}
