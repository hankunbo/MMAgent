{
  "$defs": {
    "RepeatedExplanation": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "quality_limitation",
            "resolvable_gap",
            "next_action"
          ],
          "title": "Field",
          "type": "string"
        },
        "item_index": {
          "maximum": 4,
          "minimum": 0,
          "title": "Item Index",
          "type": "integer"
        }
      },
      "required": [
        "item_index",
        "field"
      ],
      "title": "RepeatedExplanation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Checksum",
      "type": "string"
    },
    "normalized_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Normalized Checksum",
      "type": "string"
    },
    "policy": {
      "const": "identical-review-explanation-keys/1.0.0",
      "default": "identical-review-explanation-keys/1.0.0",
      "title": "Policy",
      "type": "string"
    },
    "raw_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Raw Checksum",
      "type": "string"
    },
    "repeated_fields": {
      "items": {
        "$ref": "#/$defs/RepeatedExplanation"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Repeated Fields",
      "type": "array"
    },
    "schema_version": {
      "const": "recorded-explanation-interpretation/1.0.0",
      "default": "recorded-explanation-interpretation/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scores_citations_status_unchanged": {
      "const": true,
      "default": true,
      "title": "Scores Citations Status Unchanged",
      "type": "boolean"
    }
  },
  "required": [
    "raw_checksum",
    "normalized_checksum",
    "candidate_checksum",
    "repeated_fields"
  ],
  "title": "ExplanationInterpretation",
  "type": "object"
}
