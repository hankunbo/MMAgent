{
  "additionalProperties": false,
  "properties": {
    "missing": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Missing",
      "type": "array"
    },
    "quote": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Quote",
      "type": "string"
    },
    "reason": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "relation": {
      "enum": [
        "requires",
        "organizes",
        "derived_from",
        "research_association"
      ],
      "title": "Relation",
      "type": "string"
    },
    "schema_version": {
      "const": "research-relation-candidate/1.0.0",
      "default": "research-relation-candidate/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    },
    "source_code": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Source Code",
      "type": "string"
    },
    "target": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "scope_checksum",
    "source_code",
    "quote",
    "target",
    "relation",
    "missing",
    "reason"
  ],
  "title": "SourceProposal",
  "type": "object"
}
