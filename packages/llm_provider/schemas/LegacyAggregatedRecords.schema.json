        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    },
    "TaskDefinition": {
      "additionalProperties": false,
