{
  "$defs": {
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ReviewBatchPolicy": {
      "additionalProperties": false,
      "properties": {
        "batch_size": {
          "maximum": 5,
          "minimum": 1,
          "title": "Batch Size",
          "type": "integer"
        },
        "max_batches": {
          "maximum": 20,
          "minimum": 1,
          "title": "Max Batches",
          "type": "integer"
        },
        "partition": {
          "const": "sorted_task_ids_full_parent_material",
          "default": "sorted_task_ids_full_parent_material",
          "title": "Partition",
          "type": "string"
        },
        "planner_actions": {
          "const": 1,
          "default": 1,
          "title": "Planner Actions",
          "type": "integer"
        },
        "schema_version": {
          "const": "review-batch-policy/1.0.0",
          "default": "review-batch-policy/1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "batch_size",
        "max_batches"
      ],
      "title": "ReviewBatchPolicy",
      "type": "object"
    },
    "ReviewBatchSpec": {
      "additionalProperties": false,
      "properties": {
        "assessment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Assessment Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "assessment_ids"
      ],
      "title": "ReviewBatchSpec",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Case Code",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "material_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Run Id",
          "type": "string"
        },
        "visible_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Visible Checksum",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Owner-bound reuse and new-work partitions; never mix them in one request.",
  "properties": {
    "assessment_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Assessment Ids",
      "type": "array"
    },
    "batches": {
      "items": {
        "$ref": "#/$defs/ReviewBatchSpec"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Batches",
      "type": "array"
    },
    "config_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Checksum",
      "type": "string"
    },
    "fixed_assessment_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Fixed Assessment Ids",
      "type": "array"
    },
    "key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Key",
      "type": "string"
    },
    "origin_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Origin Checksum",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/ReviewBatchPolicy"
    },
    "prompt_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Prompt Checksum",
      "type": "string"
    },
    "reused_assessment_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Reused Assessment Ids",
      "type": "array"
    },
    "round": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "title": "Round",
      "type": "string"
    },
    "schema_version": {
      "const": "review-batch-plan/1.1.0",
      "default": "review-batch-plan/1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "template_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Template Checksum",
      "type": "string"
    }
  },
  "required": [
    "key",
    "scope",
    "round",
    "template_checksum",
    "prompt_checksum",
    "config_checksum",
    "policy",
    "assessment_ids",
    "fixed_assessment_ids",
    "batches",
    "reused_assessment_ids",
    "origin_checksum"
  ],
  "title": "ReusePartitionPlan",
  "type": "object"
}
