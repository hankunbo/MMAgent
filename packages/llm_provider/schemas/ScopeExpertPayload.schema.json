{
  "$defs": {
    "ActionView": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observe",
            "select_candidate",
            "request_review",
            "fallback",
            "stop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required_inputs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "required_inputs",
        "components",
        "expires_at"
      ],
      "title": "ActionView",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "information_gain",
            "directness",
            "cost",
            "latency",
            "failure_risk"
          ],
          "title": "Name",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "disabled"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "state",
        "value",
        "source_ref"
      ],
      "title": "Component",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "ImageBinding": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "pixel_xy_top_left",
          "title": "Coordinate System",
          "type": "string"
        },
        "height": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "preprocessing": {
          "$ref": "#/$defs/Reference"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "width": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "reference",
        "media_type",
        "width",
        "height",
        "coordinate_system",
        "preprocessing",
        "location"
      ],
      "title": "ImageBinding",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "Installed reader grants visibility; a checksum alone is never authorization.",
      "properties": {
        "goal_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal Code",
          "type": "string"
        },
        "goal_summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Goal Summary",
          "type": "string"
        },
        "memory": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Memory",
          "type": "array"
        },
        "missing": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missing",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationInput"
          },
          "maxItems": 128,
          "title": "Observations",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/Reference"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 16,
          "title": "Sources",
          "type": "array"
        },
        "visibility": {
          "const": "approved_visible_projection/1.0.0",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "goal_code",
        "goal_summary",
        "visibility",
        "sources",
        "observations",
        "policy_ref",
        "missing"
      ],
      "title": "Material",
      "type": "object"
    },
    "ObservationInput": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "status": {
          "enum": [
            "obtained",
            "missing",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "reference",
        "status",
        "method",
        "unit",
        "value"
      ],
      "title": "ObservationInput",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RegionScope": {
      "additionalProperties": false,
      "properties": {
        "clarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "finding": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "limitation": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Limitation",
          "type": "string"
        },
        "region": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Region",
          "type": "string"
        },
        "visibility": {
          "enum": [
            "visible",
            "partly_visible",
            "not_identified",
            "uncertain"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "region",
        "visibility",
        "coverage",
        "clarity",
        "finding",
        "limitation"
      ],
      "title": "RegionScope",
      "type": "object"
    },
    "ReviewTask": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        },
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "assessment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/TaskDefinition"
        },
        "goal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal",
          "type": "string"
        },
        "laterality": {
          "enum": [
            "LEFT",
            "RIGHT",
            "BILATERAL",
            "UNKNOWN"
          ],
          "title": "Laterality",
          "type": "string"
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Node",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Reference"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "node",
        "goal",
        "definition",
        "observation",
        "allowed_sources",
        "method",
        "unit",
        "laterality",
        "applicable"
      ],
      "title": "ReviewTask",
      "type": "object"
    },
    "ReviewTemplate": {
      "additionalProperties": false,
      "properties": {
        "fixed_assessment_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Fixed Assessment Ids",
          "type": "array"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "scale": {
          "$ref": "#/$defs/Reference"
        },
        "schema_version": {
          "const": "review-task-projection/2.0.0",
          "default": "review-task-projection/2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/ReviewTask"
          },
          "maxItems": 128,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "scope_checksum",
        "policy_checksum",
        "scale",
        "tasks",
        "fixed_assessment_ids"
      ],
      "title": "ReviewTemplate",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Case Code",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "material_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Run Id",
          "type": "string"
        },
        "visible_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Visible Checksum",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScopeExpertReviewInput": {
      "additionalProperties": false,
      "properties": {
        "action_set_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Set Checksum",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/ScopeVisionProposal"
        },
        "event": {
          "$ref": "#/$defs/Reference"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "proposal_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposal Checksum",
          "type": "string"
        },
        "proposed_action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Proposed Action Id",
          "type": "string"
        },
        "schema_version": {
          "const": "input-scope-expert-review/1.0.0",
          "default": "input-scope-expert-review/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "triggers": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "event",
        "proposal_checksum",
        "proposed_action_id",
        "action_set_checksum",
        "policy_checksum",
        "triggers",
        "candidate"
      ],
      "title": "ScopeExpertReviewInput",
      "type": "object"
    },
    "ScopeVisionProposal": {
      "additionalProperties": false,
      "properties": {
        "finding": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "image_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Checksum",
          "type": "string"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "preprocessing_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preprocessing Checksum",
          "type": "string"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/RegionScope"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Regions",
          "type": "array"
        },
        "schema_version": {
          "const": "visual-input-scope-candidate/1.0.0",
          "default": "visual-input-scope-candidate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "image_checksum",
        "preprocessing_checksum",
        "location",
        "status",
        "finding",
        "regions"
      ],
      "title": "ScopeVisionProposal",
      "type": "object"
    },
    "SimulationExpertInput": {
      "additionalProperties": false,
      "properties": {
        "allowed_domain": {
          "const": "synthetic_offline_no_fact_edits",
          "default": "synthetic_offline_no_fact_edits",
          "title": "Allowed Domain",
          "type": "string"
        },
        "comparisons": {
          "additionalProperties": true,
          "title": "Comparisons",
          "type": "object"
        },
        "declared_candidates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Declared Candidates",
          "type": "array"
        },
        "identity": {
          "const": "hypothetical_candidate",
          "default": "hypothetical_candidate",
          "title": "Identity",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "proposed_candidate_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
