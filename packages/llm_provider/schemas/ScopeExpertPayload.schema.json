          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "policy_checksum",
        "report_checksum",
        "proposed_candidate_id",
        "declared_candidates",
        "comparisons"
      ],
      "title": "SimulationExpertInput",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "published_evidence",
            "research_material"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "enum": [
            "published",
            "research_only"
          ],
          "title": "State",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "reference",
        "locator",
        "purpose",
        "state",
        "text"
      ],
      "title": "Source",
      "type": "object"
    },
    "TaskDefinition": {
      "additionalProperties": false,
      "description": "Visible, installed definition; a missing interpretation never invents a cutoff.",
      "properties": {
        "applicability_conditions": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Applicability Conditions",
          "type": "string"
        },
        "examination": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Examination",
          "type": "string"
        },
        "interpretation": {
          "anyOf": [
            {
              "maxLength": 240,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interpretation"
