{
  "$defs": {
    "PartialObservation": {
      "additionalProperties": false,
      "description": "Task-relative estimates, not image measurements or calibrated risks.",
      "properties": {
        "basis": {
          "enum": [
            "disc_arc",
            "cup_disc_boundaries",
            "retinal_roi",
            "vessel_segments"
          ],
          "title": "Basis",
          "type": "string"
        },
        "basis_detail": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "clarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "signal": {
          "enum": [
            "present",
            "absent_in_visible_region",
            "indeterminate"
          ],
          "title": "Signal",
          "type": "string"
        },
        "unseen": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Unseen",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "visible": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Visible",
          "type": "string"
        }
      },
      "required": [
        "coverage",
        "clarity",
        "basis",
        "basis_detail",
        "visible",
        "unseen",
        "signal",
        "estimate",
        "lower",
        "upper"
      ],
      "title": "PartialObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "finding": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Finding",
      "type": "string"
    },
    "image_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Image Checksum",
      "type": "string"
    },
    "location": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Location",
      "type": "array"
    },
    "partial": {
      "$ref": "#/$defs/PartialObservation"
    },
    "preprocessing_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Preprocessing Checksum",
      "type": "string"
    },
    "schema_version": {
      "const": "visual-observation-candidate/2.0.0",
      "default": "visual-observation-candidate/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "ungradable",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "scope_checksum",
    "image_checksum",
    "preprocessing_checksum",
    "location",
    "status",
    "finding",
    "partial"
  ],
  "title": "PartialVisionProposal",
  "type": "object"
}
