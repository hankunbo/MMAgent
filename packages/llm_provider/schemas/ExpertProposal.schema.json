{
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "accept",
        "reject",
        "alternative",
        "safe_stop"
      ],
      "title": "Action",
      "type": "string"
    },
    "action_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Action Id"
    },
    "evidence": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Evidence",
      "type": "array"
    },
    "reason": {
      "maxLength": 240,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_version": {
      "const": "expert-proposal/1.0.0",
      "default": "expert-proposal/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    }
  },
  "required": [
    "scope_checksum",
    "action",
    "action_id",
    "evidence",
    "reason"
  ],
  "title": "ExpertProposal",
  "type": "object"
}
