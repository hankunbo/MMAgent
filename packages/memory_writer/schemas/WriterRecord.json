{
  "$defs": {
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Key",
          "type": "string"
        },
        "relation": {
          "default": "derived_from",
          "enum": [
            "derived_from",
            "revision_of",
            "episode_member"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "key",
        "checksum"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "EpisodeData": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "const": "recorded_events_only_missing_fields_explicit",
          "default": "recorded_events_only_missing_fields_explicit",
          "title": "Completeness",
          "type": "string"
        },
        "completion": {
          "const": "atomic_candidate",
          "default": "atomic_candidate",
          "title": "Completion",
          "type": "string"
        },
        "cross_run_rule": {
          "const": "independent_episode_original_source_links_only",
          "default": "independent_episode_original_source_links_only",
          "title": "Cross Run Rule",
          "type": "string"
        },
        "execution_attempts": {
          "$ref": "#/$defs/FieldRef"
        },
        "extension_state": {
          "const": "only_original_intent_no_dispatch",
          "default": "only_original_intent_no_dispatch",
          "title": "Extension State",
          "type": "string"
        },
        "final_graph": {
          "$ref": "#/$defs/FieldRef"
        },
        "graph_members": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 2,
          "title": "Graph Members",
          "type": "array"
        },
        "initial_graph": {
          "$ref": "#/$defs/FieldRef"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "request_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Request Key",
          "type": "string"
        },
        "runtime_report": {
          "$ref": "#/$defs/FieldRef"
        },
        "runtime_versions": {
          "$ref": "#/$defs/FieldRef"
        },
        "scores": {
          "$ref": "#/$defs/FieldRef"
        },
        "segments": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Segments",
          "type": "array"
        },
        "supplemental_members": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Supplemental Members",
          "type": "array"
        },
        "terminal": {
          "$ref": "#/$defs/Terminal"
        },
        "trajectory_count": {
          "maximum": 256,
          "minimum": 0,
          "title": "Trajectory Count",
          "type": "integer"
        },
        "trajectory_missing_reason": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Trajectory Missing Reason"
        },
        "type": {
          "const": "episode",
          "default": "episode",
          "title": "Type",
          "type": "string"
        },
        "versions": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 64,
          "title": "Versions",
          "type": "array"
        }
      },
      "required": [
        "request_key",
        "input_checksum",
        "terminal",
        "initial_graph",
        "final_graph",
        "scores",
        "versions",
        "runtime_versions",
        "execution_attempts",
        "runtime_report",
        "trajectory_count",
        "trajectory_missing_reason",
        "segments",
        "graph_members",
        "supplemental_members"
