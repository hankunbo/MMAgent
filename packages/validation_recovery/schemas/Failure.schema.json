{
  "$defs": {
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "missing_data",
            "product_demand",
            "mapping",
            "unknown_producer",
            "capability",
            "safety",
            "technical",
            "unavailable_port"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Reason",
          "type": "string"
        },
        "capability_code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Code"
        },
        "requirement_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dispatch": {
          "const": "recorded_for_11_not_dispatched",
          "default": "recorded_for_11_not_dispatched",
          "title": "Dispatch",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "reason"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "missing_input",
        "product_demand",
        "mapping_unresolved",
        "unknown_producer",
        "capability_gap",
        "admission_rejected",
        "execution_failed",
        "qc_failed",
        "medical_negative",
        "valid_refutation",
        "version_conflict"
      ],
      "title": "Category",
      "type": "string"
    },
    "target": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Target",
      "type": "string"
    },
    "reason": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Reason",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "Sources",
      "type": "array"
    },
    "gap": {
      "anyOf": [
        {
          "$ref": "#/$defs/Gap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "category",
    "target",
    "reason",
    "sources"
  ],
  "title": "Failure",
  "type": "object"
}
