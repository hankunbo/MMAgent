{
  "$defs": {
    "FileReference": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "uri": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "uri",
        "checksum",
        "byte_size"
      ],
      "title": "FileReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Only the image crosses the model boundary; no truth/diagnosis/prompt labels.",
  "properties": {
    "benchmark_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Benchmark Checksum",
      "type": "string"
    },
    "decisive_evidence": {
      "const": false,
      "default": false,
      "title": "Decisive Evidence",
      "type": "boolean"
    },
    "dimensions": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Dimensions",
      "type": "array"
    },
    "image": {
      "$ref": "#/$defs/FileReference"
    },
    "laterality": {
      "enum": [
        "right",
        "left",
        "unknown"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "purpose": {
      "const": "shadow",
      "default": "shadow",
      "title": "Purpose",
      "type": "string"
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "benchmark-image-input/1.0.0",
      "default": "benchmark-image-input/1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "benchmark_checksum",
    "sample_id",
    "image",
    "dimensions",
    "laterality"
  ],
  "title": "ModelInput",
  "type": "object"
}
