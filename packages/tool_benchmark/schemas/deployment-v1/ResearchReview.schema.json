{
  "$defs": {
    "ArtifactConstraint": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "qc_required": {
          "items": {
            "$ref": "#/$defs/QCStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Qc Required",
          "type": "array"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        }
      },
      "required": [
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "qc_required",
        "scope_terms"
      ],
      "title": "ArtifactConstraint",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "GapResolution": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "maxLength": 4096,
          "minLength": 20,
          "title": "Basis",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "verified_for_shadow",
            "formal_gate_deferred_shadow_only"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/ReviewedFile"
        },
        "gap": {
          "title": "Gap",
          "type": "string"
        }
      },
      "required": [
        "gap",
        "basis",
        "evidence",
        "disposition"
      ],
      "title": "GapResolution",
      "type": "object"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "ManifestResource": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Byte Size"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_role": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "uri": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_role",
        "uri",
        "sha256",
        "byte_size",
        "required",
        "metadata"
      ],
      "title": "ManifestResource",
      "type": "object"
    },
    "NativeManifest": {
      "additionalProperties": false,
      "description": "Exactly the public SQL function result: deliberately no enabled or ports.",
      "properties": {
        "capability_kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Capability Kind",
          "type": "string"
        },
        "entrypoint_uri": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Entrypoint Uri",
          "type": "string"
        },
        "formula_spec": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formula Spec"
        },
        "hardware_requirements": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Hardware Requirements",
          "type": "object"
        },
        "implementation_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Key",
          "type": "string"
        },
        "implementation_kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Kind",
          "type": "string"
        },
        "invocation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Invocation",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ManifestResource"
          },
          "maxItems": 128,
          "title": "Resources",
          "type": "array"
        },
        "runtime_environment": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Runtime Environment",
          "type": "object"
        },
        "tool_code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Code",
          "type": "string"
        },
        "tool_name_zh": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Name Zh",
          "type": "string"
        },
        "validation_report": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Validation Report",
          "type": "object"
        },
        "validation_status": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Validation Status",
          "type": "string"
        },
        "version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "working_directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Working Directory"
        }
      },
      "required": [
        "tool_code",
        "tool_name_zh",
        "capability_kind",
        "version",
        "implementation_key",
        "implementation_kind",
        "entrypoint_uri",
        "working_directory",
        "runtime_environment",
        "invocation",
        "formula_spec",
        "hardware_requirements",
        "provenance",
        "resources",
        "validation_status",
        "validation_report"
      ],
      "title": "NativeManifest",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReviewedFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "checksum",
        "byte_size"
      ],
      "title": "ReviewedFile",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "title": "Checksum",
      "type": "string"
    },
    "config_checksum": {
      "title": "Config Checksum",
      "type": "string"
    },
    "decisive_evidence": {
      "const": false,
      "default": false,
      "title": "Decisive Evidence",
      "type": "boolean"
    },
    "deployment_declaration": {
      "$ref": "#/$defs/NativeManifest"
    },
    "input_constraints": {
      "items": {
        "$ref": "#/$defs/ArtifactConstraint"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Input Constraints",
      "type": "array"
    },
    "interpreter": {
      "$ref": "#/$defs/ReviewedFile"
    },
    "native_resource_evidence": {
      "$ref": "#/$defs/ReviewedFile"
    },
    "origin": {
      "const": "deployment_declaration_not_native",
      "default": "deployment_declaration_not_native",
      "title": "Origin",
      "type": "string"
    },
    "output_constraints": {
      "items": {
        "$ref": "#/$defs/ArtifactConstraint"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Output Constraints",
      "type": "array"
    },
    "owner": {
      "const": "06E_DEPLOYMENT_REVIEWER",
      "default": "06E_DEPLOYMENT_REVIEWER",
      "title": "Owner",
      "type": "string"
    },
    "parameter_schema": {
      "additionalProperties": true,
      "title": "Parameter Schema",
      "type": "object"
    },
    "postprocessing_policy": {
      "additionalProperties": true,
      "title": "Postprocessing Policy",
      "type": "object"
    },
    "preprocessing_policy": {
      "additionalProperties": true,
      "title": "Preprocessing Policy",
      "type": "object"
    },
    "purposes": {
      "default": [
        "debug",
        "shadow"
      ],
      "items": {
        "enum": [
          "debug",
          "shadow"
        ],
        "type": "string"
      },
      "title": "Purposes",
      "type": "array"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/GapResolution"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Resolutions",
      "type": "array"
    },
    "source_catalog_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_implementation_ref": {
      "$ref": "#/$defs/Ref"
    },
    "source_manifest_checksum": {
      "title": "Source Manifest Checksum",
      "type": "string"
    },
    "version": {
      "const": "medgraph-research-review/1.0.0",
      "default": "medgraph-research-review/1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "checksum",
    "source_catalog_ref",
    "source_implementation_ref",
    "source_manifest_checksum",
    "config_checksum",
    "resolutions",
    "input_constraints",
    "output_constraints",
    "deployment_declaration",
    "parameter_schema",
    "preprocessing_policy",
    "postprocessing_policy",
    "interpreter",
    "native_resource_evidence"
  ],
  "title": "ResearchReview",
  "type": "object"
}
