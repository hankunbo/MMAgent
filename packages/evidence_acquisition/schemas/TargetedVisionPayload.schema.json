{
  "$defs": {
    "ActionView": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observe",
            "select_candidate",
            "request_review",
            "fallback",
            "stop"
          ],
          "title": "Kind",
          "type": "string"
        },
        "required_inputs": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "Required Inputs",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "id",
        "kind",
        "target",
        "required_inputs",
        "components",
        "expires_at"
      ],
      "title": "ActionView",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "information_gain",
            "directness",
            "cost",
            "latency",
            "failure_risk"
          ],
          "title": "Name",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "disabled"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "state",
        "value",
        "source_ref"
      ],
      "title": "Component",
      "type": "object"
    },
    "ExpertReviewInput": {
      "additionalProperties": false,
      "properties": {
        "action_set_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Set Checksum",
          "type": "string"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewProposal"
            },
            {
              "$ref": "#/$defs/SourceProposal"
            },
            {
              "$ref": "#/$defs/PartialVisionProposal"
            },
            {
              "$ref": "#/$defs/VisionProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "event": {
          "$ref": "#/$defs/Reference"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "proposal_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposal Checksum",
          "type": "string"
        },
        "proposed_action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Proposed Action Id",
          "type": "string"
        },
        "schema_version": {
          "const": "research-expert-input/1.0.0",
          "default": "research-expert-input/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "triggers": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "event",
        "proposal_checksum",
        "proposed_action_id",
        "action_set_checksum",
        "policy_checksum",
        "triggers"
      ],
      "title": "ExpertReviewInput",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "ImageBinding": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "const": "pixel_xy_top_left",
          "title": "Coordinate System",
          "type": "string"
        },
        "height": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "preprocessing": {
          "$ref": "#/$defs/Reference"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "width": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "reference",
        "media_type",
        "width",
        "height",
        "coordinate_system",
        "preprocessing",
        "location"
      ],
      "title": "ImageBinding",
      "type": "object"
    },
    "Judgment": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "method": {
          "enum": [
            "manual_source_bound_review",
            "fixed_model_margin",
            "not_assessed"
          ],
          "title": "Method",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "lower",
        "upper",
        "reason",
        "method"
      ],
      "title": "Judgment",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "description": "Installed reader grants visibility; a checksum alone is never authorization.",
      "properties": {
        "goal_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal Code",
          "type": "string"
        },
        "goal_summary": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Goal Summary",
          "type": "string"
        },
        "memory": {
          "default": [],
          "maxItems": 0,
          "minItems": 0,
          "title": "Memory",
          "type": "array"
        },
        "missing": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Missing",
          "type": "array"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ObservationInput"
          },
          "maxItems": 128,
          "title": "Observations",
          "type": "array"
        },
        "policy_ref": {
          "$ref": "#/$defs/Reference"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "maxItems": 16,
          "title": "Sources",
          "type": "array"
        },
        "visibility": {
          "const": "approved_visible_projection/1.0.0",
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "goal_code",
        "goal_summary",
        "visibility",
        "sources",
        "observations",
        "policy_ref",
        "missing"
      ],
      "title": "Material",
      "type": "object"
    },
    "ObservationInput": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageBinding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/Reference"
        },
        "status": {
          "enum": [
            "obtained",
            "missing",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "reference",
        "status",
        "method",
        "unit",
        "value"
      ],
      "title": "ObservationInput",
      "type": "object"
    },
    "PartialObservation": {
      "additionalProperties": false,
      "description": "Task-relative estimates, not image measurements or calibrated risks.",
      "properties": {
        "basis": {
          "enum": [
            "disc_arc",
            "cup_disc_boundaries",
            "retinal_roi",
            "vessel_segments"
          ],
          "title": "Basis",
          "type": "string"
        },
        "basis_detail": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "clarity": {
          "maximum": 1,
          "minimum": 0,
          "title": "Clarity",
          "type": "number"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lower"
        },
        "signal": {
          "enum": [
            "present",
            "absent_in_visible_region",
            "indeterminate"
          ],
          "title": "Signal",
          "type": "string"
        },
        "unseen": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Unseen",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "visible": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Visible",
          "type": "string"
        }
      },
      "required": [
        "coverage",
        "clarity",
        "basis",
        "basis_detail",
        "visible",
        "unseen",
        "signal",
        "estimate",
        "lower",
        "upper"
      ],
      "title": "PartialObservation",
      "type": "object"
    },
    "PartialVisionProposal": {
      "additionalProperties": false,
      "properties": {
        "finding": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "image_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Image Checksum",
          "type": "string"
        },
        "location": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Location",
          "type": "array"
        },
        "partial": {
          "$ref": "#/$defs/PartialObservation"
        },
        "preprocessing_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Preprocessing Checksum",
          "type": "string"
        },
        "schema_version": {
          "const": "visual-observation-candidate/2.0.0",
          "default": "visual-observation-candidate/2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "ungradable",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "image_checksum",
        "preprocessing_checksum",
        "location",
        "status",
        "finding",
        "partial"
      ],
      "title": "PartialVisionProposal",
      "type": "object"
    },
    "Rating": {
      "additionalProperties": false,
      "properties": {
        "missing_reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "reason"
      ],
      "title": "Rating",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Rating"
        },
        "assessment_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "comparison": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Comparison",
          "type": "string"
        },
        "judgment": {
          "$ref": "#/$defs/Judgment"
        },
        "limitation_allocation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Limitation Allocation",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Rating"
        },
        "observation_available": {
          "title": "Observation Available",
          "type": "boolean"
        },
        "observation_citations": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Observation Citations",
          "type": "array"
        },
        "reference_citations": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Reference Citations",
          "type": "array"
        },
        "relation": {
          "$ref": "#/$defs/Rating"
        },
        "status": {
          "enum": [
            "assessed",
            "reference_missing",
            "method_mismatch",
            "context_only",
            "observation_ungradable",
            "input_missing",
            "intermediate"
          ],
          "title": "Status",
          "type": "string"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "status",
        "observation_available",
        "observation_citations",
        "reference_citations",
        "comparison",
        "observation",
        "relation",
        "applicability",
        "judgment",
        "limitation_allocation",
        "unresolved"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "ReviewProposal": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "round": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Round",
          "type": "string"
        },
        "schema_version": {
          "const": "research-review-candidate/1.0.0",
          "default": "research-review-candidate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "round",
        "items"
      ],
      "title": "ReviewProposal",
      "type": "object"
    },
    "ReviewTask": {
      "additionalProperties": false,
      "properties": {
        "allowed_sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Allowed Sources",
          "type": "array"
        },
        "applicable": {
          "title": "Applicable",
          "type": "boolean"
        },
        "assessment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Assessment Id",
          "type": "string"
        },
        "definition": {
          "$ref": "#/$defs/TaskDefinition"
        },
        "goal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal",
          "type": "string"
        },
        "laterality": {
          "enum": [
            "LEFT",
            "RIGHT",
            "BILATERAL",
            "UNKNOWN"
          ],
          "title": "Laterality",
          "type": "string"
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Method",
          "type": "string"
        },
        "node": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Node",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/Reference"
        },
        "unit": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "node",
        "goal",
        "definition",
        "observation",
        "allowed_sources",
        "method",
        "unit",
