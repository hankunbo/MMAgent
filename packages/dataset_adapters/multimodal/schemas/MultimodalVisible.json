{
  "$defs": {
    "ActorType": {
      "enum": [
        "PLANNER",
        "TRACE_AGENT",
        "TOOL_AGENT",
        "VERIFICATION_AGENT",
        "EXPERT_AGENT",
        "RULE_ENGINE",
        "GRAPH_ENGINE"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_code": {
          "title": "Artifact Type Code",
          "type": "string"
        },
        "asset_code": {
          "title": "Asset Code",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "contract_type": {
          "const": "Artifact",
          "title": "Contract Type",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "dimensions": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 5,
          "title": "Dimensions",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "media_type": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "qc_status": {
          "$ref": "#/$defs/QCStatus"
        },
        "research_only": {
          "title": "Research Only",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ScopeReference"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "uri": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "provenance",
        "scope",
        "laterality",
        "coordinate_space",
        "unit",
        "asset_code",
        "artifact_type_code",
        "uri",
        "checksum",
        "media_type",
        "qc_status",
        "research_only"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "CaseBundle": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "case_code": {
          "title": "Case Code",
          "type": "string"
        },
        "contract_type": {
          "const": "CaseBundle",
          "title": "Contract Type",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "encounter_code": {
          "title": "Encounter Code",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/GoalRequest"
          },
          "minItems": 1,
          "title": "Goals",
          "type": "array"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructuredObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "patient_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Patient Hash",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "report_uri": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Uri"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ScopeReference"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "provenance",
        "scope",
        "laterality",
        "coordinate_space",
        "unit",
        "case_code",
        "patient_hash",
        "encounter_code",
        "goals"
      ],
      "title": "CaseBundle",
      "type": "object"
    },
    "CaseComponents": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "default": "multimodal-adapters/1.0.0",
          "enum": [
            "multimodal-adapters/1.0.0",
            "multimodal-adapters/1.1.0",
            "multimodal-adapters/1.2.0"
          ],
          "title": "Adapter Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "cutoff_visit": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cutoff Visit"
        },
        "dataset": {
          "enum": [
            "harvard_gdp",
            "gamma",
            "grape"
          ],
          "title": "Dataset",
          "type": "string"
        },
        "excluded_fields": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Fields",
          "type": "array"
        },
        "hidden_values_used": {
          "const": false,
          "default": false,
          "title": "Hidden Values Used",
          "type": "boolean"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "patient_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patient Group"
        },
        "patient_identity_basis": {
          "default": "unknown",
          "enum": [
            "unknown",
            "explicit_dataset_id"
          ],
          "title": "Patient Identity Basis",
          "type": "string"
        },
        "patient_independence": {
          "const": "unproven",
          "default": "unproven",
          "title": "Patient Independence",
          "type": "string"
        },
        "payloads": {
          "items": {
            "$ref": "#/$defs/Payload"
          },
          "maxItems": 1024,
          "title": "Payloads",
          "type": "array"
        },
        "quarantined_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quarantined Fields",
          "type": "array"
        },
        "release_basis": {
          "title": "Release Basis",
          "type": "string"
        },
        "runtime_ready": {
          "const": false,
          "default": false,
          "title": "Runtime Ready",
          "type": "boolean"
        },
        "sample": {
          "title": "Sample",
          "type": "string"
        },
        "schema_version": {
          "const": "case-input-components/2.0.0",
          "default": "case-input-components/2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection": {
          "enum": [
            "development_preparation",
            "training"
          ],
          "title": "Selection",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceFile"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "task": {
          "enum": [
            "glaucoma_detection",
            "glaucoma_grading",
            "observed_change"
          ],
          "title": "Task",
          "type": "string"
        },
        "visible_policy": {
          "const": "multimodal-visible/1.0.0",
          "default": "multimodal-visible/1.0.0",
          "title": "Visible Policy",
          "type": "string"
        }
      },
      "required": [
        "checksum",
        "dataset",
        "release_basis",
        "sample",
        "selection",
        "task",
        "sources",
        "payloads",
        "components",
        "excluded_fields",
        "limitations"
      ],
      "title": "CaseComponents",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "axis_semantics": {
          "default": "unknown",
          "enum": [
            "unknown",
            "source_index_only",
            "not_applicable"
          ],
          "title": "Axis Semantics",
          "type": "string"
        },
        "concept": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "expected_members": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Members"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,180}$",
          "title": "Id",
          "type": "string"
        },
        "interval_years": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Years"
        },
        "kind": {
          "enum": [
            "image",
            "volume",
            "image_series",
            "map",
            "vector",
            "scalar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "laterality": {
          "default": "UNKNOWN",
          "enum": [
            "LEFT",
            "RIGHT",
            "UNKNOWN"
          ],
          "title": "Laterality",
          "type": "string"
        },
        "member_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Member Indices",
          "type": "array"
        },
        "modality": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "payload_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Payload Ids",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "semantic_limits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Semantic Limits",
          "type": "array"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "source_locator": {
          "title": "Source Locator",
          "type": "string"
        },
        "source_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Paths",
          "type": "array"
        },
        "status": {
          "enum": [
            "obtained",
            "partial",
            "missing",
            "withheld"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "unit_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Basis"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "visit": {
          "default": "unknown",
          "title": "Visit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "concept",
        "modality",
        "status",
        "source_locator"
      ],
      "title": "Component",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "EvidenceObservationStatus": {
      "enum": [
        "UNOBSERVED",
        "POSITIVE",
        "NEGATIVE",
        "INCONCLUSIVE",
        "UNOBSERVED_TOOL_GAP",
        "NOT_APPLICABLE"
      ],
      "title": "EvidenceObservationStatus",
      "type": "string"
    },
    "GoalRequest": {
      "additionalProperties": false,
      "properties": {
        "goal_code": {
          "title": "Goal Code",
          "type": "string"
        },
        "goal_level": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Goal Level",
          "type": "string"
        }
      },
      "required": [
        "goal_code",
        "goal_level"
      ],
      "title": "GoalRequest",
      "type": "object"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "ObjectReference": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "uri": {
          "pattern": "^object://knowledge/objects/[a-f0-9]{32}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "checksum",
        "byte_size"
      ],
      "title": "ObjectReference",
      "type": "object"
    },
    "Payload": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,180}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/x-npy",
            "image/jpeg",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "projection": {
          "enum": [
            "selected_observation",
            "source_image",
            "visible_cells"
          ],
          "title": "Projection",
          "type": "string"
        },
        "source_locator": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "checksum",
        "byte_size",
        "media_type",
        "source_path",
        "source_locator",
        "projection"
      ],
      "title": "Payload",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_checksums": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Checksums",
          "type": "array"
        },
        "knowledge_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Knowledge Versions",
          "type": "array"
        },
        "rule_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Rule Versions",
          "type": "array"
        },
        "source_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Codes",
          "type": "array"
        },
        "tool_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Tool Versions",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "created_at",
        "generator_version",
        "source_codes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Code"
        },
        "episode_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Code"
        },
        "graph_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Code"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "scope_type"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "GLOBAL",
        "CASE",
        "RUN",
        "GRAPH",
        "STEP",
        "TOOL_EXTENSION",
        "MEMORY"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 134217728,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "checksum",
        "byte_size"
      ],
      "title": "SourceFile",
      "type": "object"
    },
    "StructuredObservation": {
      "additionalProperties": false,
      "properties": {
        "concept_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Concept Code",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/EvidenceObservationStatus"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
