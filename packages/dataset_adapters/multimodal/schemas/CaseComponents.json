{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "axis_semantics": {
          "default": "unknown",
          "enum": [
            "unknown",
            "source_index_only",
            "not_applicable"
          ],
          "title": "Axis Semantics",
          "type": "string"
        },
        "concept": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "expected_members": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Members"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,180}$",
          "title": "Id",
          "type": "string"
        },
        "interval_years": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Years"
        },
        "kind": {
          "enum": [
            "image",
            "volume",
            "image_series",
            "map",
            "vector",
            "scalar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "laterality": {
          "default": "UNKNOWN",
          "enum": [
            "LEFT",
            "RIGHT",
            "UNKNOWN"
          ],
          "title": "Laterality",
          "type": "string"
        },
        "member_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Member Indices",
          "type": "array"
        },
        "modality": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Modality",
          "type": "string"
        },
        "payload_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Payload Ids",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "semantic_limits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Semantic Limits",
          "type": "array"
        },
        "shape": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "source_locator": {
          "title": "Source Locator",
          "type": "string"
        },
        "source_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Paths",
          "type": "array"
        },
        "status": {
          "enum": [
            "obtained",
            "partial",
            "missing",
            "withheld"
          ],
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "unit_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Basis"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "visit": {
          "default": "unknown",
          "title": "Visit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "concept",
        "modality",
        "status",
        "source_locator"
      ],
      "title": "Component",
      "type": "object"
    },
    "Payload": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 67108864,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-zA-Z0-9_.:-]{1,180}$",
          "title": "Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "application/x-npy",
            "image/jpeg",
            "application/json"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "projection": {
          "enum": [
            "selected_observation",
            "source_image",
            "visible_cells"
          ],
          "title": "Projection",
          "type": "string"
        },
        "source_locator": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Locator",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "checksum",
        "byte_size",
        "media_type",
        "source_path",
        "source_locator",
        "projection"
      ],
      "title": "Payload",
      "type": "object"
    },
    "SourceFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 134217728,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "checksum",
        "byte_size"
      ],
      "title": "SourceFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "default": "multimodal-adapters/1.0.0",
      "enum": [
        "multimodal-adapters/1.0.0",
        "multimodal-adapters/1.1.0",
        "multimodal-adapters/1.2.0"
      ],
      "title": "Adapter Version",
      "type": "string"
    },
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "cutoff_visit": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cutoff Visit"
    },
    "dataset": {
      "enum": [
        "harvard_gdp",
        "gamma",
        "grape"
      ],
      "title": "Dataset",
      "type": "string"
    },
    "excluded_fields": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Fields",
      "type": "array"
    },
    "hidden_values_used": {
      "const": false,
      "default": false,
      "title": "Hidden Values Used",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "patient_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Patient Group"
    },
    "patient_identity_basis": {
      "default": "unknown",
      "enum": [
        "unknown",
        "explicit_dataset_id"
      ],
      "title": "Patient Identity Basis",
      "type": "string"
    },
    "patient_independence": {
      "const": "unproven",
      "default": "unproven",
      "title": "Patient Independence",
      "type": "string"
    },
    "payloads": {
      "items": {
        "$ref": "#/$defs/Payload"
      },
      "maxItems": 1024,
      "title": "Payloads",
      "type": "array"
    },
    "quarantined_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quarantined Fields",
      "type": "array"
    },
    "release_basis": {
      "title": "Release Basis",
      "type": "string"
    },
    "runtime_ready": {
      "const": false,
      "default": false,
      "title": "Runtime Ready",
      "type": "boolean"
    },
    "sample": {
      "title": "Sample",
      "type": "string"
    },
    "schema_version": {
      "const": "case-input-components/2.0.0",
      "default": "case-input-components/2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection": {
      "enum": [
        "development_preparation",
        "training"
      ],
      "title": "Selection",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceFile"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "task": {
      "enum": [
        "glaucoma_detection",
        "glaucoma_grading",
        "observed_change"
      ],
      "title": "Task",
      "type": "string"
    },
    "visible_policy": {
      "const": "multimodal-visible/1.0.0",
      "default": "multimodal-visible/1.0.0",
      "title": "Visible Policy",
      "type": "string"
    }
  },
  "required": [
    "checksum",
    "dataset",
    "release_basis",
    "sample",
    "selection",
    "task",
    "sources",
    "payloads",
    "components",
    "excluded_fields",
    "limitations"
  ],
  "title": "CaseComponents",
  "type": "object"
}
