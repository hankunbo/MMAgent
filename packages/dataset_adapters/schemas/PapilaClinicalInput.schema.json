{
  "$defs": {
    "ClinicalValue": {
      "additionalProperties": false,
      "properties": {
        "acquired": {
          "title": "Acquired",
          "type": "boolean"
        },
        "interpretation_ready": {
          "const": false,
          "default": false,
          "title": "Interpretation Ready",
          "type": "boolean"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "missing_reason": {
          "anyOf": [
            {
              "const": "not_recorded",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "source_cell": {
          "title": "Source Cell",
          "type": "string"
        },
        "source_checksum": {
          "title": "Source Checksum",
          "type": "string"
        },
        "source_field": {
          "title": "Source Field",
          "type": "string"
        },
        "timepoint": {
          "const": "unknown",
          "default": "unknown",
          "title": "Timepoint",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "unit_basis": {
          "enum": [
            "paper",
            "convention_pending_confirmation",
            "unresolved",
            "coding"
          ],
          "title": "Unit Basis",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value",
        "unit",
        "unit_basis",
        "source_field",
        "source_cell",
        "source_checksum",
        "acquired"
      ],
      "title": "ClinicalValue",
      "type": "object"
    },
    "FileBinding": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 33554432,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "relative_path": {
          "maxLength": 200,
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "checksum",
        "byte_size"
      ],
      "title": "FileBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "age_years": {
      "anyOf": [
        {
          "maximum": 120,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Age Years"
    },
    "clinical": {
      "additionalProperties": {
        "$ref": "#/$defs/ClinicalValue"
      },
      "title": "Clinical",
      "type": "object"
    },
    "clinical_source": {
      "$ref": "#/$defs/FileBinding"
    },
    "dataset": {
      "const": "PAPILA",
      "default": "PAPILA",
      "title": "Dataset",
      "type": "string"
    },
    "definition_source": {
      "const": "https://doi.org/10.1038/s41597-022-01388-1",
      "default": "https://doi.org/10.1038/s41597-022-01388-1",
      "title": "Definition Source",
      "type": "string"
    },
    "dimensions": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Dimensions",
      "type": "array"
    },
    "final_test_unlocked": {
      "const": false,
      "default": false,
      "title": "Final Test Unlocked",
      "type": "boolean"
    },
    "image": {
      "$ref": "#/$defs/FileBinding"
    },
    "laterality": {
      "enum": [
        "RIGHT",
        "LEFT"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "modality": {
      "const": "color_fundus",
      "default": "color_fundus",
      "title": "Modality",
      "type": "string"
    },
    "patient_group": {
      "pattern": "^PAPILA:RET[0-9]{3}$",
      "title": "Patient Group",
      "type": "string"
    },
    "profile": {
      "enum": [
        "image_demographics",
        "image_demographics_clinical"
      ],
      "title": "Profile",
      "type": "string"
    },
    "purpose": {
      "const": "development_preparation",
      "default": "development_preparation",
      "title": "Purpose",
      "type": "string"
    },
    "runtime_admission": {
      "const": false,
      "default": false,
      "title": "Runtime Admission",
      "type": "boolean"
    },
    "sample_id": {
      "pattern": "^RET[0-9]{3}(OD|OS)$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "papila-clinical-preparation/1.0.0",
      "default": "papila-clinical-preparation/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sex": {
      "anyOf": [
        {
          "enum": [
            "male",
            "female"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sex"
    },
    "sex_mapping": {
      "const": "PAPILA:0=male;1=female",
      "default": "PAPILA:0=male;1=female",
      "title": "Sex Mapping",
      "type": "string"
    },
    "source_version": {
      "const": "PAPILAv1.1",
      "default": "PAPILAv1.1",
      "title": "Source Version",
      "type": "string"
    },
    "unavailable_modalities": {
      "default": [
        "OCT_volume",
        "VF_pointwise",
        "longitudinal"
      ],
      "items": {
        "enum": [
          "OCT_volume",
          "VF_pointwise",
          "longitudinal"
        ],
        "type": "string"
      },
      "title": "Unavailable Modalities",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "sample_id",
    "patient_group",
    "laterality",
    "image",
    "dimensions",
    "age_years",
    "sex",
    "clinical",
    "clinical_source"
  ],
  "title": "PapilaClinicalInput",
  "type": "object"
}
