{
  "$defs": {
    "ArtifactConstraint": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        },
        "qc_required": {
          "items": {
            "$ref": "#/$defs/QCStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Qc Required",
          "type": "array"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        }
      },
      "required": [
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "qc_required",
        "scope_terms"
      ],
      "title": "ArtifactConstraint",
      "type": "object"
    },
    "CandidateObservation": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Identity",
          "type": "string"
        },
        "records": {
          "items": {
            "discriminator": {
              "mapping": {
                "tool-candidate-provenance/1.0.0": "#/$defs/packages__tool_discovery__models__Provenance",
                "tool-candidate-provenance/1.1.0": "#/$defs/packages__tool_discovery__models_v11__Provenance"
              },
              "propertyName": "schema_version"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/packages__tool_discovery__models_v11__Provenance"
              },
              {
                "$ref": "#/$defs/packages__tool_discovery__models__Provenance"
              }
            ]
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Records",
          "type": "array"
        },
        "identity_evidence": {
          "items": {
            "$ref": "#/$defs/RegisteredIdentity"
          },
          "maxItems": 128,
          "title": "Identity Evidence",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "discovered",
            "incomplete",
            "quarantined"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "missing": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "rejection_codes": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Rejection Codes",
          "type": "array"
        },
        "dimensions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Dimensions",
          "type": "object"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "source_priority": {
          "title": "Source Priority",
          "type": "integer"
        },
        "machine_gate": {
          "default": null,
          "title": "Machine Gate",
          "type": "null"
        },
        "onboarding_job": {
          "default": null,
          "title": "Onboarding Job",
          "type": "null"
        },
        "input_match": {
          "$ref": "#/$defs/ContractMatch"
        }
      },
      "required": [
        "identity",
        "records",
        "identity_evidence",
        "disposition",
        "missing",
        "rejection_codes",
        "dimensions",
        "score",
        "source_priority",
        "input_match"
      ],
      "title": "CandidateObservation",
      "type": "object"
    },
    "ContractMatch": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "exact",
            "compatible",
            "missing",
            "incompatible"
          ],
          "title": "Status",
          "type": "string"
        },
        "requirement_contract_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Requirement Contract Checksum",
          "type": "string"
        },
        "reasons": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "omitted_optional": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortRef"
          },
          "title": "Omitted Optional",
          "type": "array"
        }
      },
      "required": [
        "status",
        "requirement_contract_checksum",
        "reasons"
      ],
      "title": "ContractMatch",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "DiscoveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "tool-discovery-policy/1.0.0",
          "default": "tool-discovery-policy/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "baseline_only": {
          "const": true,
          "default": true,
          "title": "Baseline Only",
          "type": "boolean"
        },
        "max_records": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Records",
          "type": "integer"
        },
        "max_sources": {
          "default": 8,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Sources",
          "type": "integer"
        },
        "max_seconds": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "commit_margin_seconds": {
          "default": 2,
          "maximum": 10,
          "minimum": 1,
          "title": "Commit Margin Seconds",
          "type": "integer"
        },
        "max_metadata_bytes": {
          "default": 262144,
          "maximum": 524288,
          "minimum": 1024,
          "title": "Max Metadata Bytes",
          "type": "integer"
        },
        "top_k": {
          "default": 5,
          "maximum": 32,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "max_memory_mb": {
          "default": 4096,
          "maximum": 65536,
          "minimum": 1,
          "title": "Max Memory Mb",
          "type": "integer"
        },
        "allow_gpu": {
          "const": false,
          "default": false,
          "title": "Allow Gpu",
          "type": "boolean"
        },
        "weights": {
          "default": [
            1.0,
            1.0,
            1.0,
            1.0,
            0.5,
            0.0,
            0.5
          ],
          "items": {
            "type": "number"
          },
          "title": "Weights",
          "type": "array"
        }
      },
      "title": "DiscoveryPolicy",
      "type": "object"
    },
    "DiscoveryQuery": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "tool-discovery-query/1.1.0",
          "default": "tool-discovery-query/1.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "application_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Application Checksum",
          "type": "string"
        },
        "requirement": {
          "additionalProperties": true,
          "title": "Requirement",
          "type": "object"
        },
        "purpose": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Purpose",
          "type": "string"
        },
        "contracts": {
          "items": {
            "$ref": "#/$defs/packages__tool_discovery__models_v11__Semantics"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Contracts",
          "type": "array"
        },
        "max_memory_mb": {
          "title": "Max Memory Mb",
          "type": "integer"
        },
        "gpu_allowed": {
          "const": false,
          "default": false,
          "title": "Gpu Allowed",
          "type": "boolean"
        },
        "missing": {
          "default": [
            "evaluation_dataset",
            "threshold_policy"
          ],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "application_checksum",
        "requirement",
        "purpose",
        "contracts",
        "max_memory_mb"
      ],
      "title": "DiscoveryQuery",
      "type": "object"
    },
    "InputMapping": {
      "additionalProperties": false,
