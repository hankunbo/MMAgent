      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
