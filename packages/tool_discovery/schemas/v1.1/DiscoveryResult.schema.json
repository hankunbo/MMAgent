    "RegisteredIdentity": {
      "additionalProperties": false,
      "description": "Installed fixture registry evidence, independent of a record's official claim.",
      "properties": {
        "identity_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
