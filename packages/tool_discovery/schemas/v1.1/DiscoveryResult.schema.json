          "type": "boolean"
        }
      },
      "required": [
        "identity_ref",
        "repository",
        "repository_owner",
        "model_id",
        "revision",
        "code_checksum",
        "weights_checksum",
        "source_urls",
        "official"
      ],
      "title": "RegisteredIdentity",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
