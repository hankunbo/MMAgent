{
  "$defs": {
    "ArtifactConstraint": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        },
        "qc_required": {
          "items": {
            "$ref": "#/$defs/QCStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Qc Required",
          "type": "array"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        }
      },
      "required": [
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "qc_required",
        "scope_terms"
      ],
      "title": "ArtifactConstraint",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "InputMapping": {
      "additionalProperties": false,
      "properties": {
        "requirement_contract_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Requirement Contract Checksum",
          "type": "string"
        },
        "bindings": {
          "items": {
            "$ref": "#/$defs/PortBinding"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Bindings",
          "type": "array"
        },
        "omitted_optional": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PortRef"
          },
          "maxItems": 64,
          "title": "Omitted Optional",
          "type": "array"
        }
      },
      "required": [
        "requirement_contract_checksum",
        "bindings"
      ],
      "title": "InputMapping",
      "type": "object"
    },
    "InputRequirement": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required"
        },
        "cardinality_min": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cardinality Min"
        },
        "cardinality_max": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cardinality Max"
        }
      },
      "title": "InputRequirement",
      "type": "object"
    },
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "PortBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/PortRef"
        },
        "target": {
          "$ref": "#/$defs/PortRef"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "PortBinding",
      "type": "object"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "tool_ref": {
          "$ref": "#/$defs/Ref"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "port_name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Port Name",
          "type": "string"
        }
      },
      "required": [
        "tool_ref",
        "direction",
        "port_name"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Semantics": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "additionalProperties": true,
          "title": "Capability",
          "type": "object"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRequirement"
          },
          "maxItems": 64,
          "title": "Inputs",
          "type": "array"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "task_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Task Type",
          "type": "string"
        },
        "intended_use": {
          "const": "research_only",
          "default": "research_only",
          "title": "Intended Use",
          "type": "string"
        },
        "schema_version": {
          "const": "tool-candidate-semantics/1.1.0",
          "default": "tool-candidate-semantics/1.1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "inputs",
        "output",
        "task_type"
      ],
      "title": "Semantics",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "tool-candidate-provenance/1.1.0",
      "default": "tool-candidate-provenance/1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "local_contract",
        "official_package",
        "official_model",
        "paper_code",
        "lead"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_url": {
      "maxLength": 2048,
      "title": "Source Url",
      "type": "string"
    },
    "identity_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Ref"
    },
    "repository": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "repository_owner": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Owner"
    },
    "model_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "revision": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "revision_kind": {
      "anyOf": [
        {
          "enum": [
            "commit",
            "immutable_version",
            "branch"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Kind"
    },
    "claimed_official": {
      "default": false,
      "title": "Claimed Official",
      "type": "boolean"
    },
    "paper_doi": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paper Doi"
    },
    "code_license": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code License"
    },
    "weights_license": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights License"
    },
    "code_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Checksum"
    },
    "weights_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights Checksum"
    },
    "weights_required": {
      "default": true,
      "title": "Weights Required",
      "type": "boolean"
    },
    "model_card": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Card"
    },
    "framework": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Framework"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Dependencies",
      "type": "array"
    },
    "inference_entry": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Entry"
    },
    "semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Semantics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_shape": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Shape",
      "type": "array"
    },
    "output_shape": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Output Shape",
      "type": "array"
    },
    "preprocessing": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preprocessing"
    },
    "postprocessing": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Postprocessing"
    },
    "memory_mb": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Mb"
    },
    "requires_gpu": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requires Gpu"
    },
    "uploads_patient_data": {
      "default": false,
      "title": "Uploads Patient Data",
      "type": "boolean"
    },
    "arbitrary_remote_code": {
      "default": false,
      "title": "Arbitrary Remote Code",
      "type": "boolean"
    },
    "training_data": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Data"
    },
    "evaluation_data": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Data"
    },
    "performance_claim": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Performance Claim"
    },
    "applicability": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability"
    },
    "limitations": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitations"
    },
    "input_mappings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InputMapping"
      },
      "maxItems": 128,
      "title": "Input Mappings",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "source_kind",
    "source_url"
  ],
  "title": "Provenance",
  "type": "object"
}
