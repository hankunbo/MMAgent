{
  "$defs": {
    "ArtifactConstraint": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        },
        "qc_required": {
          "items": {
            "$ref": "#/$defs/QCStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Qc Required",
          "type": "array"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        }
      },
      "required": [
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "qc_required",
        "scope_terms"
      ],
      "title": "ArtifactConstraint",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "InputRequirement": {
      "additionalProperties": false,
      "properties": {
        "port": {
          "anyOf": [
            {
              "$ref": "#/$defs/PortRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactConstraint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required"
        },
        "cardinality_min": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cardinality Min"
        },
        "cardinality_max": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cardinality Max"
        }
      },
      "title": "InputRequirement",
      "type": "object"
    },
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "tool_ref": {
          "$ref": "#/$defs/Ref"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "port_name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Port Name",
          "type": "string"
        }
      },
      "required": [
        "tool_ref",
        "direction",
        "port_name"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
          ],
          "title": "State",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capability": {
      "additionalProperties": true,
      "title": "Capability",
      "type": "object"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputRequirement"
      },
      "maxItems": 64,
      "title": "Inputs",
      "type": "array"
    },
    "output": {
      "additionalProperties": true,
      "title": "Output",
      "type": "object"
    },
    "task_type": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Task Type",
      "type": "string"
    },
    "intended_use": {
      "const": "research_only",
      "default": "research_only",
      "title": "Intended Use",
      "type": "string"
    },
    "schema_version": {
      "const": "tool-candidate-semantics/1.1.0",
      "default": "tool-candidate-semantics/1.1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "capability",
    "inputs",
    "output",
    "task_type"
  ],
  "title": "Semantics",
  "type": "object"
}
