{
  "$defs": {
    "Semantics": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "additionalProperties": true,
          "title": "Capability",
          "type": "object"
        },
        "inputs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Inputs",
          "type": "array"
        },
        "output": {
          "additionalProperties": true,
          "title": "Output",
          "type": "object"
        },
        "task_type": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Task Type",
          "type": "string"
        },
        "intended_use": {
          "const": "research_only",
          "default": "research_only",
          "title": "Intended Use",
          "type": "string"
        }
      },
      "required": [
        "capability",
        "inputs",
        "output",
        "task_type"
      ],
      "title": "Semantics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Missing evidence is null; digests refer to fixture bytes in this phase.",
  "properties": {
    "schema_version": {
      "const": "tool-candidate-provenance/1.0.0",
      "default": "tool-candidate-provenance/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "local_contract",
        "official_package",
        "official_model",
        "paper_code",
        "lead"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "source_url": {
      "maxLength": 2048,
      "title": "Source Url",
      "type": "string"
    },
    "identity_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identity Ref"
    },
    "repository": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository"
    },
    "repository_owner": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repository Owner"
    },
    "model_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "revision": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "revision_kind": {
      "anyOf": [
        {
          "enum": [
            "commit",
            "immutable_version",
            "branch"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Kind"
    },
    "claimed_official": {
      "default": false,
      "title": "Claimed Official",
      "type": "boolean"
    },
    "paper_doi": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paper Doi"
    },
    "code_license": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code License"
    },
    "weights_license": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights License"
    },
    "code_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Checksum"
    },
    "weights_checksum": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weights Checksum"
    },
    "weights_required": {
      "default": true,
      "title": "Weights Required",
      "type": "boolean"
    },
    "model_card": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Card"
    },
    "framework": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Framework"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Dependencies",
      "type": "array"
    },
    "inference_entry": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Entry"
    },
    "semantics": {
      "anyOf": [
        {
          "$ref": "#/$defs/Semantics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "input_shape": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Shape",
      "type": "array"
    },
    "output_shape": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Output Shape",
      "type": "array"
    },
    "preprocessing": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preprocessing"
    },
    "postprocessing": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Postprocessing"
    },
    "memory_mb": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Mb"
    },
    "requires_gpu": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requires Gpu"
    },
    "uploads_patient_data": {
      "default": false,
      "title": "Uploads Patient Data",
      "type": "boolean"
    },
    "arbitrary_remote_code": {
      "default": false,
      "title": "Arbitrary Remote Code",
      "type": "boolean"
    },
    "training_data": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Training Data"
    },
    "evaluation_data": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Data"
    },
    "performance_claim": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Performance Claim"
    },
    "applicability": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applicability"
    },
    "limitations": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limitations"
    }
  },
  "required": [
    "record_id",
    "source_kind",
    "source_url"
  ],
  "title": "Provenance",
  "type": "object"
}
