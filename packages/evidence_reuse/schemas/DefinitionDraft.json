        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Input Concepts",
      "type": "array"
    },
    "interpretation": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
