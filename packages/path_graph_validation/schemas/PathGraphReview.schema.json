{
  "$defs": {
    "ExpertDecision": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "research-expert-decision/1.0.0",
          "default": "research-expert-decision/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/Reference"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "proposal_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Proposal Checksum",
          "type": "string"
        },
        "proposed_action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Proposed Action Id",
          "type": "string"
        },
        "action_set_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Action Set Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "source_uses": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/Reference"
              },
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Source Uses",
          "type": "array"
        },
        "triggers": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "request_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Request Ids",
          "type": "array"
        },
        "suggestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpertProposal"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "alternative",
            "safe_stop",
            "baseline"
          ],
          "title": "Decision",
          "type": "string"
        },
        "selected_action_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Action Id"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Reason",
          "type": "string"
        },
        "clinical_acceptance": {
          "const": false,
          "default": false,
          "title": "Clinical Acceptance",
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "scope",
        "proposal_checksum",
        "proposed_action_id",
        "action_set_checksum",
        "policy_checksum",
        "source_uses",
        "triggers",
        "required",
        "request_ids",
        "suggestion",
        "decision",
        "selected_action_id",
        "reason"
      ],
      "title": "ExpertDecision",
      "type": "object"
    },
    "ExpertProposal": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "expert-proposal/1.0.0",
          "default": "expert-proposal/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Scope Checksum",
          "type": "string"
        },
        "action": {
          "enum": [
            "accept",
            "reject",
            "alternative",
            "safe_stop"
          ],
          "title": "Action",
          "type": "string"
        },
        "action_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action Id"
        },
        "evidence": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence",
          "type": "array"
        },
        "reason": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "scope_checksum",
        "action",
        "action_id",
        "evidence",
        "reason"
      ],
      "title": "ExpertProposal",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "kind": {
          "enum": [
            "research_artifact",
            "formal_geceg"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum",
        "kind"
      ],
      "title": "Graph",
      "type": "object"
    },
    "PathGraphSummary": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "path-graph-validation/1.0.0",
          "default": "path-graph-validation/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "domain": {
          "enum": [
            "research",
            "formal_synthetic"
          ],
          "title": "Domain",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "research_offline",
            "synthetic_mechanism"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "case_code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Case Code",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "graph": {
          "additionalProperties": true,
          "title": "Graph",
          "type": "object"
        },
        "binding": {
          "additionalProperties": true,
          "title": "Binding",
          "type": "object"
        },
        "paths": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Paths",
          "type": "array"
        },
        "goals": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Goals",
          "type": "array"
        },
        "evidence": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Evidence",
          "type": "array"
        },
        "unresolved": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "relations": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Relations",
          "type": "array"
        },
        "duplicate_groups": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Duplicate Groups",
          "type": "array"
        },
        "coverage": {
          "additionalProperties": true,
          "title": "Coverage",
          "type": "object"
        },
        "risk": {
          "additionalProperties": true,
          "title": "Risk",
          "type": "object"
        },
        "review_facts": {
          "additionalProperties": true,
          "title": "Review Facts",
          "type": "object"
        },
        "original_report": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Report"
        },
        "original_report_checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Report Checksum"
        },
        "legal_candidates": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Legal Candidates",
          "type": "array"
        },
        "stop_candidate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Candidate"
        },
        "clinical_acceptance": {
          "const": false,
          "default": false,
          "title": "Clinical Acceptance",
          "type": "boolean"
        },
        "live_status": {
          "const": "live_domain_acceptance_not_enabled",
          "default": "live_domain_acceptance_not_enabled",
          "title": "Live Status",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "domain",
        "purpose",
        "case_code",
        "run_id",
        "graph",
        "binding",
        "paths",
        "goals",
        "evidence",
        "unresolved",
        "coverage",
        "risk",
        "review_facts",
        "checksum"
      ],
      "title": "PathGraphSummary",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Role",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "role",
        "code",
        "version",
        "checksum"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Case Code",
          "type": "string"
        },
        "run_id": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Run Id",
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "visible_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Visible Checksum",
          "type": "string"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "material_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Material Checksum",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "run_id",
        "graph",
        "visible_checksum",
        "input_checksum",
        "material_checksum",
        "policy_checksum"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "path-graph-review/1.0.0",
      "default": "path-graph-review/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "summary_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Summary Checksum",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/PathGraphSummary"
    },
    "event": {
      "$ref": "#/$defs/Reference"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "expert_decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpertDecision"
        },
        {
          "type": "null"
        }
      ]
    },
    "disposition": {
      "const": "candidate_only_no_tool_dispatch",
      "title": "Disposition",
      "type": "string"
    },
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    }
  },
  "required": [
    "summary_checksum",
    "summary",
    "event",
    "result",
    "expert_decision",
    "disposition",
    "checksum"
  ],
  "title": "PathGraphReview",
  "type": "object"
}
