{
  "$defs": {
    "Conditions": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Domain",
          "type": "string"
        },
        "failure_types": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Failure Types",
          "type": "array"
        },
        "goal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal",
          "type": "string"
        },
        "graph_conditions": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Graph Conditions",
          "type": "array"
        },
        "inputs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "modalities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "patient_conditions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Patient Conditions",
          "type": "object"
        },
        "rule_versions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Rule Versions",
          "type": "object"
        },
        "template": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Template",
          "type": "string"
        },
        "tool_versions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Tool Versions",
          "type": "object"
        },
        "validation": {
          "const": "synthetic_engineering",
          "default": "synthetic_engineering",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "goal",
        "template",
        "graph_conditions",
        "modalities",
        "inputs",
        "patient_conditions",
        "tool_versions",
        "rule_versions",
        "failure_types",
        "domain"
      ],
      "title": "Conditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Prompt projection: references/conditions only, never full H definitions or outputs.",
  "properties": {
    "binding_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Binding Checksum",
      "type": "string"
    },
    "conditions": {
      "$ref": "#/$defs/Conditions"
    },
    "content_version": {
      "enum": [
        "research-memory/1.0.0",
        "research-memory/1.1.0",
        "research-memory/1.2.0"
      ],
      "title": "Content Version",
      "type": "string"
    },
    "instruction": {
      "const": "candidate_advice_only_no_publication",
      "default": "candidate_advice_only_no_publication",
      "title": "Instruction",
      "type": "string"
    },
    "role": {
      "const": "expert",
      "default": "expert",
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "memory-agent-input/1.1.0",
      "default": "memory-agent-input/1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "additionalProperties": true,
      "title": "Scope",
      "type": "object"
    },
    "sources": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Sources",
      "type": "array"
    },
    "target": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Target",
      "type": "string"
    },
    "target_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Target Checksum",
      "type": "string"
    },
    "task_profile": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Task Profile",
      "type": "string"
    },
    "task_proofs": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Task Proofs",
      "type": "array"
    }
  },
  "required": [
    "scope",
    "target",
    "target_checksum",
    "content_version",
    "binding_checksum",
    "conditions",
    "task_profile",
    "task_proofs",
    "sources"
  ],
  "title": "TaskReviewInput",
  "type": "object"
}
