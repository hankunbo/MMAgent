{
  "additionalProperties": false,
  "properties": {
    "case_code": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Case Code",
      "type": "string"
    },
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "config_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Checksum",
      "type": "string"
    },
    "context_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Context Checksum",
      "type": "string"
    },
    "execution_policy": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Policy",
      "type": "string"
    },
    "goal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Goal",
      "type": "string"
    },
    "plan_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Checksum",
      "type": "string"
    },
    "profile": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Profile",
      "type": "string"
    },
    "request_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Checksum",
      "type": "string"
    },
    "requirements": {
      "additionalProperties": true,
      "title": "Requirements",
      "type": "object"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "research-task-definition/1.0.0",
      "default": "research-task-definition/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    },
    "score_policy": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Score Policy",
      "type": "string"
    },
    "task": {
      "const": "single_tool_verified_outputs_and_saved_scores",
      "default": "single_tool_verified_outputs_and_saved_scores",
      "title": "Task",
      "type": "string"
    },
    "use": {
      "const": "synthetic_offline_planning_prior",
      "default": "synthetic_offline_planning_prior",
      "title": "Use",
      "type": "string"
    },
    "validity_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Validity Seconds",
      "type": "integer"
    }
  },
  "required": [
    "checksum",
    "goal",
    "profile",
    "run_id",
    "case_code",
    "context_checksum",
    "request_checksum",
    "scope_checksum",
    "plan_checksum",
    "config_checksum",
    "execution_policy",
    "score_policy",
    "requirements",
    "validity_seconds"
  ],
  "title": "TaskDefinition",
  "type": "object"
}
