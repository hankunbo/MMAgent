{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "synthetic_fixture_mapping",
          "default": "synthetic_fixture_mapping",
          "title": "Basis",
          "type": "string"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "content_version": {
          "enum": [
            "research-memory/1.0.0",
            "research-memory/1.1.0",
            "research-memory/1.2.0"
          ],
          "title": "Content Version",
          "type": "string"
        },
        "group": {
          "enum": [
            "success",
            "counterfactual",
            "recovery"
          ],
          "title": "Group",
          "type": "string"
        },
        "preferred_branches": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Preferred Branches",
          "type": "array"
        },
        "schema_version": {
          "const": "memory-use-binding/1.0.0",
          "default": "memory-use-binding/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Target",
          "type": "string"
        },
        "target_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Checksum",
          "type": "string"
        },
        "terms": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "target",
        "target_checksum",
        "content_version",
        "conditions",
        "group",
        "preferred_branches"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Conditions": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Domain",
          "type": "string"
        },
        "failure_types": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Failure Types",
          "type": "array"
        },
        "goal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Goal",
          "type": "string"
        },
        "graph_conditions": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Graph Conditions",
          "type": "array"
        },
        "inputs": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "modalities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Modalities",
          "type": "array"
        },
        "patient_conditions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Patient Conditions",
          "type": "object"
        },
        "rule_versions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Rule Versions",
          "type": "object"
        },
        "template": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Template",
          "type": "string"
        },
        "tool_versions": {
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Tool Versions",
          "type": "object"
        },
        "validation": {
          "const": "synthetic_engineering",
          "default": "synthetic_engineering",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "goal",
        "template",
        "graph_conditions",
        "modalities",
        "inputs",
        "patient_conditions",
        "tool_versions",
        "rule_versions",
        "failure_types",
        "domain"
      ],
      "title": "Conditions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Key",
      "type": "string"
    },
    "opinions": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Opinions",
      "type": "array"
    },
    "policy_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Checksum",
      "type": "string"
    },
    "policy_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Policy Key",
      "type": "string"
    },
    "purpose": {
      "const": "synthetic_offline",
      "default": "synthetic_offline",
      "title": "Purpose",
      "type": "string"
    },
    "schema_version": {
      "const": "memory-publication/1.0.0",
      "default": "memory-publication/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "test_context": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Test Context",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    }
  },
  "required": [
    "key",
    "binding",
    "policy_key",
    "policy_checksum",
    "opinions",
    "valid_from",
    "expires_at",
    "test_context"
  ],
  "title": "Publication",
  "type": "object"
}
