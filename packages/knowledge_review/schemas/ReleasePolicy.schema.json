{
  "$defs": {
    "KnowledgeKind": {
      "enum": [
        "source_provider",
        "search_query",
        "search_run",
        "search_hit",
        "source",
        "source_identifier",
        "source_version",
        "source_document",
        "document_chunk",
        "ingestion_job",
        "clinical_claim",
        "claim_evidence_link",
        "claim_conflict",
        "extraction_run",
        "applicability_condition",
        "concept",
        "target",
        "template",
        "node",
        "edge",
        "evidence_requirement",
        "validation_rule",
        "stop_rule",
        "release",
        "expert_review",
        "release_policy"
      ],
      "title": "KnowledgeKind",
      "type": "string"
    },
    "KnowledgeReference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/KnowledgeKind"
        },
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 5,
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "KnowledgeReference",
      "type": "object"
    },
    "ResearchScope": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "knowledge-research-scope/1.0.0",
          "default": "knowledge-research-scope/1.0.0",
          "title": "Version",
          "type": "string"
        },
        "purpose": {
          "const": "limited_research_evidence_planning",
          "title": "Purpose",
          "type": "string"
        },
        "definition_ref": {
          "$ref": "#/$defs/VersionedReference"
        },
        "context_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Context Checksum",
          "type": "string"
        },
        "allowed_outputs": {
          "items": {
            "enum": [
              "evidence_requirements",
              "insufficiency",
              "limitations"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Allowed Outputs",
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "definition_ref",
        "context_checksum",
        "allowed_outputs"
      ],
      "title": "ResearchScope",
      "type": "object"
    },
    "ReviewerRole": {
      "enum": [
        "REVIEWER",
        "EXPERT_AGENT"
      ],
      "title": "ReviewerRole",
      "type": "string"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "release_policy",
      "default": "release_policy",
      "title": "Kind",
      "type": "string"
    },
    "code": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Code",
      "type": "string"
    },
    "version": {
      "maxLength": 64,
      "minLength": 5,
      "title": "Version",
      "type": "string"
    },
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "scope": {
      "const": "GLOBAL",
      "default": "GLOBAL",
      "title": "Scope",
      "type": "string"
    },
    "synthetic": {
      "default": false,
      "title": "Synthetic",
      "type": "boolean"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/KnowledgeReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KnowledgeReference"
      },
      "maxItems": 64,
      "title": "Source Refs",
      "type": "array"
    },
    "applicability_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/KnowledgeReference"
      },
      "maxItems": 64,
      "title": "Applicability Refs",
      "type": "array"
    },
    "unresolved_decisions": {
      "default": [],
      "items": {
        "enum": [
          "GRA-002",
          "KNO-008"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "title": "Unresolved Decisions",
      "type": "array"
    },
    "research_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "workflow_version": {
      "anyOf": [
        {
          "const": "offline-release/1.0.0",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Version"
    },
    "min_reviews": {
      "maximum": 32,
      "minimum": 1,
      "title": "Min Reviews",
      "type": "integer"
    },
    "allowed_reviewer_roles": {
      "items": {
        "$ref": "#/$defs/ReviewerRole"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Allowed Reviewer Roles",
      "type": "array"
    },
    "authorized_publisher_codes": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Authorized Publisher Codes",
      "type": "array"
    },
    "synthetic_only": {
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "baseline_only": {
      "title": "Baseline Only",
      "type": "boolean"
    },
    "formal_review_policy_frozen": {
      "title": "Formal Review Policy Frozen",
      "type": "boolean"
    },
    "require_resolved_conflicts": {
      "default": true,
      "title": "Require Resolved Conflicts",
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "version",
    "checksum",
    "min_reviews",
    "allowed_reviewer_roles",
    "authorized_publisher_codes",
    "synthetic_only",
    "baseline_only",
    "formal_review_policy_frozen"
  ],
  "title": "ReleasePolicy",
  "type": "object"
}
