        "model_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "base_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Base Url"
        },
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Api Key Env"
        },
        "endpoint": {
          "anyOf": [
            {
              "const": "chat_completions",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endpoint"
        },
        "timeout_seconds": {
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_retries": {
          "maximum": 3,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "prompt_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Prompt Checksum",
          "type": "string"
        },
        "schema_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Checksum",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/BatchPolicy"
        }
      },
      "required": [
        "method",
        "extractor_version",
        "extractor_config_checksum",
        "code_checksum",
        "model",
        "model_version",
        "base_url",
        "api_key_env",
        "endpoint",
        "timeout_seconds",
        "max_retries",
        "prompt_checksum",
        "schema_checksum",
        "budget"
      ],
      "title": "ConfigurationSnapshot",
      "type": "object"
    },
