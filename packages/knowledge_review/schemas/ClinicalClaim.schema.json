          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Original Checksum",
          "type": "string"
        },
        "parse_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Parse Checksum",
          "type": "string"
        },
        "chunk_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Chunk Checksum",
          "type": "string"
        },
        "parse_uri": {
          "maxLength": 256,
          "pattern": "^object://knowledge/objects/[A-Za-z0-9_-]+$",
          "title": "Parse Uri",
          "type": "string"
