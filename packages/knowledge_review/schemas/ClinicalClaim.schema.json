          "type": "string"
        },
        "max_requests": {
          "maximum": 256,
          "minimum": 1,
          "title": "Max Requests",
          "type": "integer"
        },
        "max_input_chars": {
          "maximum": 512000,
          "minimum": 1,
          "title": "Max Input Chars",
          "type": "integer"
        },
        "max_output_tokens": {
          "maximum": 16000,
          "minimum": 256,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "total_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "title": "Total Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_requests",
        "max_input_chars",
        "max_output_tokens",
        "total_seconds"
      ],
      "title": "BatchPolicy",
      "type": "object"
    },
    "CandidateSourceBinding": {
      "additionalProperties": false,
      "properties": {
        "index_key": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Index Key",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Reference"
        },
        "source_version": {
          "$ref": "#/$defs/Reference"
        },
