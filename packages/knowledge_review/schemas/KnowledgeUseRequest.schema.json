{
  "$defs": {
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        },
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "knowledge-use-request/1.0.0",
      "default": "knowledge-use-request/1.0.0",
      "title": "Version",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "limited_research_evidence_planning",
        "clinical"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "policy_ref": {
      "$ref": "#/$defs/VersionedReference"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    }
  },
  "required": [
    "purpose",
    "policy_ref",
    "scope_checksum"
  ],
  "title": "KnowledgeUseRequest",
  "type": "object"
}
