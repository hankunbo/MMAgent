{
  "$defs": {
    "ActorType": {
      "enum": [
        "PLANNER",
        "TRACE_AGENT",
        "TOOL_AGENT",
        "VERIFICATION_AGENT",
        "EXPERT_AGENT",
        "RULE_ENGINE",
        "GRAPH_ENGINE"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "DataAvailability": {
      "enum": [
        "AVAILABLE",
        "DERIVABLE",
        "ACQUIRABLE",
        "UNAVAILABLE",
        "NOT_APPLICABLE"
      ],
      "title": "DataAvailability",
      "type": "string"
    },
    "EdgeType": {
      "enum": [
        "AND_CHILD",
        "OR_CHILD",
        "SUPPORTS",
        "REFUTES",
        "EXCLUDES",
        "FALSIFIES",
        "CAUSES",
        "RISK_MODIFIES",
        "REQUIRES_INPUT",
        "PRODUCES",
        "VALIDATED_BY",
        "CONFLICTS_WITH"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_type": {
          "$ref": "#/$defs/EdgeType"
        },
        "rule_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_node_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Source Node Code",
          "type": "string"
        },
        "target_node_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Target Node Code",
          "type": "string"
        }
      },
      "required": [
        "source_node_code",
        "target_node_code",
        "edge_type"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNodeInstance": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/DataAvailability"
        },
        "concept_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Concept Code",
          "type": "string"
        },
        "evidence_bindings": {
          "default": [],
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "title": "Evidence Bindings",
          "type": "array"
        },
        "node_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Node Code",
          "type": "string"
        },
        "node_type": {
          "$ref": "#/$defs/NodeType"
        },
        "status": {
          "$ref": "#/$defs/GraphNodeStatus"
        }
      },
      "required": [
        "node_code",
        "node_type",
        "concept_code",
        "status",
        "availability"
      ],
      "title": "GraphNodeInstance",
      "type": "object"
    },
    "GraphNodeStatus": {
      "enum": [
        "UNKNOWN",
        "PENDING",
        "SUPPORTED",
        "REFUTED",
        "CONFLICTED",
        "EXCLUDED",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "GraphNodeStatus",
      "type": "string"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "NodeType": {
      "enum": [
        "GOAL",
        "CLAIM",
        "EVIDENCE",
        "DATA",
        "TOOL",
        "QC",
        "EXCLUSION",
        "ACTION",
        "LOGIC_GATE"
      ],
      "title": "NodeType",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_checksums": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Checksums",
          "type": "array"
        },
        "knowledge_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Knowledge Versions",
          "type": "array"
        },
        "rule_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Rule Versions",
          "type": "array"
        },
        "source_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Codes",
          "type": "array"
        },
        "tool_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Tool Versions",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "created_at",
        "generator_version",
        "source_codes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Code"
        },
        "episode_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Code"
        },
        "graph_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Code"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "scope_type"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "GLOBAL",
        "CASE",
        "RUN",
        "GRAPH",
        "STEP",
        "TOOL_EXTENSION",
        "MEMORY"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_code": {
      "title": "Case Code",
      "type": "string"
    },
    "contract_type": {
      "const": "GECEGInstance",
      "title": "Contract Type",
      "type": "string"
    },
    "coordinate_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "edges": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraphEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "goal_node_code": {
      "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
      "title": "Goal Node Code",
      "type": "string"
    },
    "graph_code": {
      "title": "Graph Code",
      "type": "string"
    },
    "graph_version": {
      "minimum": 1,
      "title": "Graph Version",
      "type": "integer"
    },
    "laterality": {
      "$ref": "#/$defs/Laterality"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphNodeInstance"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeReference"
    },
    "template_ref": {
      "$ref": "#/$defs/VersionedReference"
    },
    "unit": {
      "anyOf": [
        {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "provenance",
    "scope",
    "laterality",
    "coordinate_space",
    "unit",
    "graph_code",
    "case_code",
    "template_ref",
    "graph_version",
    "goal_node_code",
    "nodes"
  ],
  "title": "GECEGInstance",
  "type": "object"
}
