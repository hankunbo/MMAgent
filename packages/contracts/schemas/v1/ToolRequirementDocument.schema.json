{
  "$defs": {
    "ActorType": {
      "enum": [
        "PLANNER",
        "TRACE_AGENT",
        "TOOL_AGENT",
        "VERIFICATION_AGENT",
        "EXPERT_AGENT",
        "RULE_ENGINE",
        "GRAPH_ENGINE"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ArtifactRequirement": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_code": {
          "title": "Artifact Type Code",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "artifact_type_code",
        "required",
        "laterality",
        "coordinate_space",
        "unit"
      ],
      "title": "ArtifactRequirement",
      "type": "object"
    },
    "AttemptedCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_code": {
          "title": "Candidate Code",
          "type": "string"
        },
        "failed_stage": {
          "$ref": "#/$defs/RequirementFailureStage"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "candidate_code",
        "failed_stage",
        "reason_codes"
      ],
      "title": "AttemptedCandidate",
      "type": "object"
    },
    "CaseImpact": {
      "enum": [
        "NONE",
        "REDUCED_COMPLETENESS",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "CaseImpact",
      "type": "string"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "ImmutablePolicyReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "policy_code": {
          "title": "Policy Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_code",
        "version",
        "checksum"
      ],
      "title": "ImmutablePolicyReference",
      "type": "object"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "MetricRequirement": {
      "additionalProperties": false,
      "properties": {
        "metric_code": {
          "title": "Metric Code",
          "type": "string"
        },
        "unit": {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric_code",
        "unit"
      ],
      "title": "MetricRequirement",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_checksums": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Checksums",
          "type": "array"
        },
        "knowledge_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Knowledge Versions",
          "type": "array"
        },
        "rule_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Rule Versions",
          "type": "array"
        },
        "source_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Codes",
          "type": "array"
        },
        "tool_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Tool Versions",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "created_at",
        "generator_version",
        "source_codes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RequirementFailureStage": {
      "enum": [
        "ELIGIBILITY",
        "ADAPT",
        "SANDBOX",
        "SMOKE",
        "BENCHMARK",
        "POLICY_GATE"
      ],
      "title": "RequirementFailureStage",
      "type": "string"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Code"
        },
        "episode_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Code"
        },
        "graph_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Code"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "scope_type"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "GLOBAL",
        "CASE",
        "RUN",
        "GRAPH",
        "STEP",
        "TOOL_EXTENSION",
        "MEMORY"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "ValidationPlan": {
      "additionalProperties": false,
      "properties": {
        "frozen_datasets": {
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Frozen Datasets",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricRequirement"
          },
          "title": "Metrics",
          "type": "array"
        },
        "threshold_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImmutablePolicyReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "frozen_datasets",
        "metrics"
      ],
      "title": "ValidationPlan",
      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempted_candidates": {
      "items": {
        "$ref": "#/$defs/AttemptedCandidate"
      },
      "title": "Attempted Candidates",
      "type": "array"
    },
    "available_alternatives": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
        "type": "string"
      },
      "title": "Available Alternatives",
      "type": "array"
    },
    "available_inputs": {
      "items": {
        "type": "string"
      },
      "title": "Available Inputs",
      "type": "array"
    },
    "blocked_nodes": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
        "type": "string"
      },
      "title": "Blocked Nodes",
      "type": "array"
    },
    "capability_code": {
      "title": "Capability Code",
      "type": "string"
    },
    "clinical_purpose": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Clinical Purpose",
      "type": "string"
    },
    "conclusion_effect": {
      "$ref": "#/$defs/CaseImpact"
    },
    "contract_type": {
      "const": "ToolRequirementDocument",
      "title": "Contract Type",
      "type": "string"
    },
    "coordinate_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "extension_job_id": {
      "title": "Extension Job Id",
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "laterality": {
      "$ref": "#/$defs/Laterality"
    },
    "origin_run_id": {
      "title": "Origin Run Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "replay_when_available": {
      "title": "Replay When Available",
      "type": "boolean"
    },
    "required_input_contract": {
      "items": {
        "$ref": "#/$defs/ArtifactRequirement"
      },
      "minItems": 1,
      "title": "Required Input Contract",
      "type": "array"
    },
    "required_output_contract": {
      "items": {
        "$ref": "#/$defs/ArtifactRequirement"
      },
      "minItems": 1,
      "title": "Required Output Contract",
      "type": "array"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeReference"
    },
    "target_node_code": {
      "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
      "title": "Target Node Code",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "validation_plan": {
      "$ref": "#/$defs/ValidationPlan"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "provenance",
    "scope",
    "laterality",
    "coordinate_space",
    "unit",
    "requirement_id",
    "origin_run_id",
    "extension_job_id",
    "target_node_code",
    "capability_code",
    "clinical_purpose",
    "available_inputs",
    "required_input_contract",
    "required_output_contract",
    "attempted_candidates",
    "validation_plan",
    "blocked_nodes",
    "conclusion_effect",
    "available_alternatives",
    "replay_when_available"
  ],
  "title": "ToolRequirementDocument",
  "type": "object"
}
