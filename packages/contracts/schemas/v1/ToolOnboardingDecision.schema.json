{
  "$defs": {
    "ActorType": {
      "enum": [
        "PLANNER",
        "TRACE_AGENT",
        "TOOL_AGENT",
        "VERIFICATION_AGENT",
        "EXPERT_AGENT",
        "RULE_ENGINE",
        "GRAPH_ENGINE"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "ImmutablePolicyReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "policy_code": {
          "title": "Policy Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_code",
        "version",
        "checksum"
      ],
      "title": "ImmutablePolicyReference",
      "type": "object"
    },
    "IntendedUse": {
      "enum": [
        "research_only",
        "clinical_deployment"
      ],
      "title": "IntendedUse",
      "type": "string"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "MachineEvaluation": {
      "additionalProperties": false,
      "properties": {
        "evaluation_code": {
          "title": "Evaluation Code",
          "type": "string"
        },
        "evaluator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Evaluator Version",
          "type": "string"
        },
        "gate_evidence": {
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "minItems": 1,
          "title": "Gate Evidence",
          "type": "array"
        },
        "implementation_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Implementation Checksum",
          "type": "string"
        },
        "implementation_code": {
          "title": "Implementation Code",
          "type": "string"
        },
        "implementation_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Implementation Version",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "policy_ref": {
          "$ref": "#/$defs/ImmutablePolicyReference"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "result_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Checksum",
          "type": "string"
        }
      },
      "required": [
        "evaluation_code",
        "job_id",
        "implementation_code",
        "implementation_version",
        "implementation_checksum",
        "evaluator_version",
        "result_checksum",
        "policy_ref",
        "passed",
        "gate_evidence",
        "reason_codes"
      ],
      "title": "MachineEvaluation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_checksums": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Checksums",
          "type": "array"
        },
        "knowledge_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Knowledge Versions",
          "type": "array"
        },
        "rule_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Rule Versions",
          "type": "array"
        },
        "source_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Codes",
          "type": "array"
        },
        "tool_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Tool Versions",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "created_at",
        "generator_version",
        "source_codes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Code"
        },
        "episode_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Code"
        },
        "graph_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Code"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "scope_type"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "GLOBAL",
        "CASE",
        "RUN",
        "GRAPH",
        "STEP",
        "TOOL_EXTENSION",
        "MEMORY"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "ToolCatalogStatus": {
      "enum": [
        "candidate",
        "registered",
        "active",
        "quarantined",
        "failed",
        "deprecated"
      ],
      "title": "ToolCatalogStatus",
      "type": "string"
    },
    "ToolExtensionJobStatus": {
      "enum": [
        "REQUESTED",
        "DISCOVERING",
        "CHECKING_ELIGIBILITY",
        "STAGING",
        "ADAPTING",
        "SANDBOX_TESTING",
        "SMOKE_TESTING",
        "BENCHMARKING",
        "POLICY_GATE",
        "ACTIVATED_NEXT_RUN",
        "REQUIREMENT_DOCUMENTED",
        "FAILED"
      ],
      "title": "ToolExtensionJobStatus",
      "type": "string"
    },
    "ToolValidationStatus": {
      "enum": [
        "unvalidated",
        "smoke_tested",
        "benchmark_passed",
        "auto_validated_research"
      ],
      "title": "ToolValidationStatus",
      "type": "string"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_status": {
      "$ref": "#/$defs/ToolCatalogStatus"
    },
    "contract_type": {
      "const": "ToolOnboardingDecision",
      "title": "Contract Type",
      "type": "string"
    },
    "coordinate_space": {
      "$ref": "#/$defs/CoordinateSpace"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "extension_job_status": {
      "$ref": "#/$defs/ToolExtensionJobStatus"
    },
    "extensions": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Extensions",
      "type": "object"
    },
    "implementation_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Implementation Checksum",
      "type": "string"
    },
    "implementation_code": {
      "title": "Implementation Code",
      "type": "string"
    },
    "implementation_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
      "title": "Implementation Version",
      "type": "string"
    },
    "intended_use": {
      "$ref": "#/$defs/IntendedUse"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "laterality": {
      "$ref": "#/$defs/Laterality"
    },
    "machine_evaluation": {
      "$ref": "#/$defs/MachineEvaluation"
    },
    "policy_ref": {
      "$ref": "#/$defs/ImmutablePolicyReference"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "published_catalog_version": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published Catalog Version"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeReference"
    },
    "unit": {
      "anyOf": [
        {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "validation_status": {
      "$ref": "#/$defs/ToolValidationStatus"
    },
    "visible_to_current_run": {
      "const": false,
      "title": "Visible To Current Run",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "contract_type",
    "provenance",
    "scope",
    "laterality",
    "coordinate_space",
    "unit",
    "decision_id",
    "job_id",
    "extension_job_status",
    "catalog_status",
    "validation_status",
    "intended_use",
    "implementation_code",
    "implementation_version",
    "implementation_checksum",
    "policy_ref",
    "machine_evaluation",
    "visible_to_current_run"
  ],
  "title": "ToolOnboardingDecision",
  "type": "object"
}
