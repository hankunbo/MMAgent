{
  "additionalProperties": false,
  "description": "Source-bound partial index: keep non-table blocks, retain the entire parse.",
  "properties": {
    "version": {
      "const": "2.3.0",
      "default": "2.3.0",
      "title": "Version",
      "type": "string"
    },
    "max_chars": {
      "default": 1200,
      "maximum": 4096,
      "minimum": 64,
      "title": "Max Chars",
      "type": "integer"
    },
    "overlap_chars": {
      "default": 100,
      "maximum": 512,
      "minimum": 0,
      "title": "Overlap Chars",
      "type": "integer"
    },
    "max_chunks": {
      "default": 192,
      "maximum": 250,
      "minimum": 1,
      "title": "Max Chunks",
      "type": "integer"
    },
    "projection_version": {
      "const": "bounded-projection/1.0.0",
      "default": "bounded-projection/1.0.0",
      "title": "Projection Version",
      "type": "string"
    },
    "selection": {
      "const": "non-table-blocks/1.0.0",
      "default": "non-table-blocks/1.0.0",
      "title": "Selection",
      "type": "string"
    },
    "source_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Source Checksum",
      "type": "string"
    }
  },
  "required": [
    "source_checksum"
  ],
  "title": "ProseChunkPolicy",
  "type": "object"
}
