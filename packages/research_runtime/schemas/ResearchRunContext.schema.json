{
  "$defs": {
    "ArtifactConstraint": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "qc_required": {
          "items": {
            "$ref": "#/$defs/QCStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Qc Required",
          "type": "array"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        }
      },
      "required": [
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "qc_required",
        "scope_terms"
      ],
      "title": "ArtifactConstraint",
      "type": "object"
    },
    "ArtifactMetadata": {
      "additionalProperties": false,
      "description": "Explicit ingestion projection. No URI, report, measurements or image bytes.",
      "properties": {
        "acquired_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acquired At"
        },
        "artifact_ref": {
          "$ref": "#/$defs/Ref"
        },
        "asset_code": {
          "pattern": "^ASSET:(ANON|OID)_[A-Z0-9][A-Z0-9_-]{5,63}$",
          "title": "Asset Code",
          "type": "string"
        },
        "case_code": {
          "title": "Case Code",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "encounter_code": {
          "title": "Encounter Code",
          "type": "string"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "modality": {
          "$ref": "#/$defs/Term"
        },
        "patient_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Patient Hash",
          "type": "string"
        },
        "qc_status": {
          "$ref": "#/$defs/QCStatus"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "scope_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Scope Terms",
          "type": "array"
        },
        "unit": {
          "$ref": "#/$defs/Term"
        }
      },
      "required": [
        "asset_code",
        "checksum",
        "case_code",
        "patient_hash",
        "encounter_code",
        "run_id",
        "artifact_ref",
        "modality",
        "laterality",
        "coordinate_space",
        "unit",
        "scope_terms",
        "qc_status",
        "acquired_at"
      ],
      "title": "ArtifactMetadata",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "capability_ref": {
          "$ref": "#/$defs/Ref"
        },
        "code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Code",
          "type": "string"
        },
        "estimate_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_policy": {
          "$ref": "#/$defs/ExecutionPolicy"
        },
        "implementation_ref": {
          "$ref": "#/$defs/Ref"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "intended_use": {
          "$ref": "#/$defs/IntendedUse"
        },
        "output": {
          "$ref": "#/$defs/ArtifactConstraint"
        },
        "output_port": {
          "$ref": "#/$defs/PortRef"
        },
        "tool_ref": {
          "$ref": "#/$defs/Ref"
        },
        "validation_required": {
          "$ref": "#/$defs/ToolValidationStatus"
        },
        "workflow_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "capability_ref",
        "tool_ref",
        "implementation_ref",
        "workflow_ref",
        "output_port",
        "output",
        "inputs",
        "validation_required",
        "intended_use",
        "execution_policy",
        "estimate_ref"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "CaseScope": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "pattern": "^CASE:(ANON|OID)_[A-Z0-9][A-Z0-9_-]{5,63}$",
          "title": "Case Code",
          "type": "string"
        },
        "encounter_code": {
          "pattern": "^ENCOUNTER:(ANON|OID)_[A-Z0-9][A-Z0-9_-]{5,63}$",
          "title": "Encounter Code",
          "type": "string"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "patient_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Patient Hash",
          "type": "string"
        }
      },
      "required": [
        "case_code",
        "patient_hash",
        "encounter_code",
        "laterality"
      ],
      "title": "CaseScope",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "ExecutionPolicy": {
      "enum": [
        "research",
        "clinical_deployment"
      ],
      "title": "ExecutionPolicy",
      "type": "string"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "cardinality_max": {
          "maximum": 64,
          "minimum": 1,
          "title": "Cardinality Max",
          "type": "integer"
        },
        "cardinality_min": {
          "maximum": 64,
          "minimum": 0,
          "title": "Cardinality Min",
          "type": "integer"
        },
        "constraint": {
          "$ref": "#/$defs/ArtifactConstraint"
        },
        "port": {
          "$ref": "#/$defs/PortRef"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "port",
        "constraint",
        "required",
        "cardinality_min",
        "cardinality_max"
      ],
      "title": "Input",
      "type": "object"
    },
    "IntendedUse": {
      "enum": [
        "research_only",
        "clinical_deployment"
      ],
      "title": "IntendedUse",
      "type": "string"
    },
    "InvocationInput": {
      "additionalProperties": false,
      "properties": {
        "implementation_ref": {
          "$ref": "#/$defs/Ref"
        },
        "manifest_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Checksum",
          "type": "string"
        },
        "parameters": {
          "maxProperties": 64,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$": {
              "$ref": "#/$defs/JsonValue"
            }
          },
          "title": "Parameters",
          "type": "object"
        },
        "profile_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Profile Checksum",
          "type": "string"
        }
      },
      "required": [
        "implementation_ref",
        "manifest_checksum",
        "profile_checksum",
        "parameters"
      ],
      "title": "InvocationInput",
      "type": "object"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "accepted_validation": {
          "items": {
            "$ref": "#/$defs/ToolValidationStatus"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Accepted Validation",
          "type": "array"
        },
        "admissible_states": {
          "items": {
            "const": "Active",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Admissible States",
          "type": "array"
        },
        "allowed_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Allowed Terms",
          "type": "array"
        },
        "baseline_only": {
          "const": true,
          "title": "Baseline Only",
          "type": "boolean"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Code",
          "type": "string"
        },
        "execution_policy": {
          "const": "research",
          "title": "Execution Policy",
          "type": "string"
        },
        "intended_use": {
          "const": "research_only",
          "title": "Intended Use",
          "type": "string"
        },
        "kind": {
          "const": "policy",
          "default": "policy",
          "title": "Kind",
          "type": "string"
        },
        "max_artifacts": {
          "maximum": 32,
          "minimum": 1,
          "title": "Max Artifacts",
          "type": "integer"
        },
        "max_bytes": {
          "maximum": 65536,
          "minimum": 1024,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_candidates": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_inputs": {
          "maximum": 64,
          "minimum": 1,
          "title": "Max Inputs",
          "type": "integer"
        },
        "max_mappings": {
          "maximum": 128,
          "minimum": 1,
          "title": "Max Mappings",
          "type": "integer"
        },
        "synthetic_only": {
          "title": "Synthetic Only",
          "type": "boolean"
        },
        "type_compatibility": {
          "const": "exact",
          "title": "Type Compatibility",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version",
        "checksum",
        "baseline_only",
        "synthetic_only",
        "admissible_states",
        "type_compatibility",
        "accepted_validation",
        "intended_use",
        "execution_policy",
        "max_bytes",
        "max_candidates",
        "max_inputs",
        "max_artifacts",
        "max_mappings",
        "allowed_terms"
      ],
      "title": "Policy",
      "type": "object"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "port_name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Port Name",
          "type": "string"
        },
        "tool_ref": {
          "$ref": "#/$defs/Ref"
        }
      },
      "required": [
        "tool_ref",
        "direction",
        "port_name"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ResearchInput": {
      "additionalProperties": false,
      "properties": {
        "asset_codes": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Asset Codes",
          "type": "array"
        },
        "port": {
          "$ref": "#/$defs/PortRef"
        }
      },
      "required": [
        "port",
        "asset_codes"
      ],
      "title": "ResearchInput",
      "type": "object"
    },
    "ResearchLock": {
      "additionalProperties": false,
      "properties": {
        "catalog_ref": {
          "$ref": "#/$defs/Ref"
        },
        "run_id": {
          "pattern": "^RUN:(ANON|OID)_[A-Z0-9][A-Z0-9_-]{5,63}$",
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "catalog_ref"
      ],
      "title": "ResearchLock",
      "type": "object"
    },
    "ResearchRequest": {
      "additionalProperties": false,
      "description": "Separate exact registered request: no medical claim, mapping or Draft payload.",
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactMetadata"
          },
          "maxItems": 256,
          "title": "Artifacts",
          "type": "array"
        },
        "candidate": {
          "$ref": "#/$defs/Candidate"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "maxLength": 256,
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
          "title": "Code",
          "type": "string"
        },
        "compatibility_policy": {
          "$ref": "#/$defs/Policy"
        },
        "decisive_evidence": {
          "const": false,
          "default": false,
          "title": "Decisive Evidence",
          "type": "boolean"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/ResearchInput"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "invocation": {
          "$ref": "#/$defs/InvocationInput"
        },
        "lock": {
          "$ref": "#/$defs/ResearchLock"
        },
        "purpose": {
          "enum": [
            "debug",
            "shadow"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "satisfied_terms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Satisfied Terms",
          "type": "array"
        },
        "schema_version": {
          "const": "tool-research-admission/1.0.0",
          "default": "tool-research-admission/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/CaseScope"
        },
        "snapshot_at": {
          "format": "date-time",
          "title": "Snapshot At",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version",
        "checksum",
        "purpose",
        "compatibility_policy",
        "lock",
        "scope",
        "window_start",
        "window_end",
        "snapshot_at",
        "satisfied_terms",
        "artifacts",
        "candidate",
        "inputs",
        "invocation"
      ],
      "title": "ResearchRequest",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "Term",
      "type": "object"
    },
    "ToolValidationStatus": {
      "enum": [
        "unvalidated",
        "smoke_tested",
        "benchmark_passed",
        "auto_validated_research"
      ],
      "title": "ToolValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "decisive_evidence": {
      "const": false,
      "default": false,
      "title": "Decisive Evidence",
      "type": "boolean"
    },
    "request": {
      "$ref": "#/$defs/ResearchRequest"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "schema_version": {
      "const": "research-run/1.0.0",
      "default": "research-run/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Checksum",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "checksum",
    "request",
    "synthetic",
    "scope_checksum"
  ],
  "title": "ResearchRunContext",
  "type": "object"
}
