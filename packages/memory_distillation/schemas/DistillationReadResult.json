          "title": "Review Status",
          "type": "string"
        },
        "semantics_version": {
          "const": "counterfactual-semantics/1.1.0",
          "title": "Semantics Version",
          "type": "string"
        },
        "simulated": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Simulated"
        },
        "simulation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Simulation Id",
          "type": "string"
        },
        "source_roles": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Source Roles",
          "type": "array"
        },
        "type": {
          "const": "counterfactual_pair",
          "default": "counterfactual_pair",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_key",
        "context",
        "report_source",
        "simulation_id",
        "policy",
        "assessment_contexts",
        "semantics_version",
        "changes",
        "affected",
        "remaining",
        "baseline",
        "simulated",
        "comparisons",
        "alternatives",
        "classification",
        "display",
        "reasons",
        "review",
        "source_roles",
        "limitations",
        "original_counters"
      ],
      "title": "PairData",
      "type": "object"
    },
    "RecoveryData": {
      "additionalProperties": false,
      "properties": {
        "attempted_alternatives": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Attempted Alternatives",
          "type": "array"
        },
        "before_phase": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Before Phase",
          "type": "string"
        },
