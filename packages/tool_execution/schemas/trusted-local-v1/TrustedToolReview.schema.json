{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "ReviewedFile": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "checksum",
        "byte_size"
      ],
      "title": "ReviewedFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Installed by deployment assembly, not accepted on the execute request port.\n\nDigests detect drift. They do not make code reviewed. review_record must explain\nprovenance, inspected implementation/weights and the exact research scope.",
  "properties": {
    "allowlist_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Allowlist Checksum",
      "type": "string"
    },
    "decisive_evidence": {
      "const": false,
      "default": false,
      "title": "Decisive Evidence",
      "type": "boolean"
    },
    "entrypoint": {
      "$ref": "#/$defs/ReviewedFile"
    },
    "environment_root": {
      "title": "Environment Root",
      "type": "string"
    },
    "executable": {
      "$ref": "#/$defs/ReviewedFile"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ReviewedFile"
      },
      "maxItems": 16384,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "implementation_ref": {
      "$ref": "#/$defs/Ref"
    },
    "inventory_roots": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Inventory Roots",
      "type": "array"
    },
    "manifest_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Checksum",
      "type": "string"
    },
    "research_only": {
      "const": true,
      "default": true,
      "title": "Research Only",
      "type": "boolean"
    },
    "review_record": {
      "$ref": "#/$defs/ReviewedFile"
    },
    "version": {
      "default": "trusted-tool-review/1.0.0",
      "enum": [
        "trusted-tool-review/1.0.0",
        "trusted-tool-review/1.1.0"
      ],
      "title": "Version",
      "type": "string"
    },
    "working_directory": {
      "const": "attempt/root",
      "default": "attempt/root",
      "title": "Working Directory",
      "type": "string"
    }
  },
  "required": [
    "implementation_ref",
    "manifest_checksum",
    "allowlist_checksum",
    "review_record",
    "environment_root",
    "executable",
    "entrypoint",
    "files",
    "inventory_roots"
  ],
  "title": "TrustedToolReview",
  "type": "object"
}
