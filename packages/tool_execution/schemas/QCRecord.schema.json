{
  "$defs": {
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Checksum",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "type": "integer"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "implementation": {
      "title": "Implementation",
      "type": "string"
    },
    "initial_qc_status": {
      "const": "PENDING",
      "default": "PENDING",
      "title": "Initial Qc Status",
      "type": "string"
    },
    "logical_uri": {
      "title": "Logical Uri",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "policy_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Checksum",
      "type": "string"
    },
    "qc_policy_ref": {
      "$ref": "#/$defs/Ref"
    },
    "status": {
      "$ref": "#/$defs/QCStatus"
    }
  },
  "required": [
    "status",
    "dimensions",
    "media_type",
    "policy_checksum",
    "qc_policy_ref",
    "content_checksum",
    "implementation",
    "logical_uri"
  ],
  "title": "QCRecord",
  "type": "object"
}
