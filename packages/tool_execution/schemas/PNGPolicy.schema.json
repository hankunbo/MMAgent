{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Term": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 256,
              "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9][A-Z0-9._-]*)+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "not_applicable",
            "unspecified"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "code"
      ],
      "title": "Term",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_ref": {
      "$ref": "#/$defs/Ref"
    },
    "artifact_type_code": {
      "title": "Artifact Type Code",
      "type": "string"
    },
    "implementation": {
      "const": "png_grayscale8_labels/1.0.0",
      "default": "png_grayscale8_labels/1.0.0",
      "title": "Implementation",
      "type": "string"
    },
    "labels": {
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Labels",
      "type": "array"
    },
    "max_pixels": {
      "maximum": 16777216,
      "minimum": 1,
      "title": "Max Pixels",
      "type": "integer"
    },
    "role": {
      "enum": [
        "model_prediction",
        "derived_product"
      ],
      "title": "Role",
      "type": "string"
    },
    "same_shape_as_first_input": {
      "const": true,
      "default": true,
      "title": "Same Shape As First Input",
      "type": "boolean"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unit"
    },
    "unit_term": {
      "$ref": "#/$defs/Term"
    }
  },
  "required": [
    "artifact_ref",
    "artifact_type_code",
    "unit",
    "unit_term",
    "role",
    "labels",
    "max_pixels"
  ],
  "title": "PNGPolicy",
  "type": "object"
}
