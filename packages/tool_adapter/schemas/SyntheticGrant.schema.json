{
  "additionalProperties": false,
  "description": "Installed stage authority, never an argument to consume or inferred from selected.",
  "properties": {
    "schema_version": {
      "const": "synthetic-adapter-grant/1.0.0",
      "default": "synthetic-adapter-grant/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "stage_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Stage Key",
      "type": "string"
    },
    "worker": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Worker",
      "type": "string"
    },
    "application_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Application Checksum",
      "type": "string"
    },
    "discovery_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Discovery Checksum",
      "type": "string"
    },
    "candidate_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Identity",
      "type": "string"
    },
    "manifest_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Checksum",
      "type": "string"
    },
    "policy_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Checksum",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "purpose": {
      "const": "synthetic_adapter_contract_only",
      "default": "synthetic_adapter_contract_only",
      "title": "Purpose",
      "type": "string"
    },
    "budget": {
      "const": 1,
      "default": 1,
      "title": "Budget",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "stage_key",
    "worker",
    "application_checksum",
    "discovery_checksum",
    "candidate_identity",
    "manifest_checksum",
    "policy_checksum",
    "expires_at"
  ],
  "title": "SyntheticGrant",
  "type": "object"
}
