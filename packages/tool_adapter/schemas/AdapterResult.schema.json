{
  "$defs": {
    "GateEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "synthetic-adapter-gate/1.0.0",
          "default": "synthetic-adapter-gate/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "contract",
            "fake_smoke",
            "sandbox",
            "benchmark",
            "policy"
          ],
          "title": "Stage",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "incompatible",
            "missing",
            "not_executed",
            "technical_failure",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "policy_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Checksum",
          "type": "string"
        },
        "input_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Checksum",
          "type": "string"
        },
        "evidence_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Checksum",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "reasons": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "outcome",
        "policy_checksum",
        "input_checksum",
        "evidence_checksum",
        "evidence",
        "reasons"
      ],
      "title": "GateEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "synthetic-adapter-result/1.0.0",
      "default": "synthetic-adapter-result/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "plan_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Checksum",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    },
    "outcome": {
      "enum": [
        "failed",
        "incompatible",
        "missing",
        "not_executed",
        "technical_failure",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "candidate_disposition": {
      "enum": [
        "discovered",
        "incomplete",
        "quarantined"
      ],
      "title": "Candidate Disposition",
      "type": "string"
    },
    "catalog_status": {
      "enum": [
        "candidate",
        "quarantined",
        "failed"
      ],
      "title": "Catalog Status",
      "type": "string"
    },
    "catalog_written": {
      "const": false,
      "default": false,
      "title": "Catalog Written",
      "type": "boolean"
    },
    "extension_job_status": {
      "enum": [
        "REQUIREMENT_DOCUMENTED",
        "FAILED"
      ],
      "title": "Extension Job Status",
      "type": "string"
    },
    "formal_job_created": {
      "const": false,
      "default": false,
      "title": "Formal Job Created",
      "type": "boolean"
    },
    "validation_status": {
      "const": "unvalidated",
      "default": "unvalidated",
      "title": "Validation Status",
      "type": "string"
    },
    "intended_use": {
      "const": "research_only",
      "default": "research_only",
      "title": "Intended Use",
      "type": "string"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateEvidence"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Gates",
      "type": "array"
    },
    "missing": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
        "type": "string"
      },
      "title": "Missing",
      "type": "array"
    },
    "completed": {
      "const": false,
      "default": false,
      "title": "Completed",
      "type": "boolean"
    },
    "available_next_run": {
      "const": false,
      "default": false,
      "title": "Available Next Run",
      "type": "boolean"
    },
    "live_domain_acceptance": {
      "const": "live_domain_acceptance_not_enabled",
      "default": "live_domain_acceptance_not_enabled",
      "title": "Live Domain Acceptance",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "plan_checksum",
    "outcome",
    "candidate_disposition",
    "catalog_status",
    "extension_job_status",
    "gates",
    "missing"
  ],
  "title": "AdapterResult",
  "type": "object"
}
