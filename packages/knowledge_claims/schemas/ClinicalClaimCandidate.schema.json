    },
    "paragraph": {
      "minimum": 1,
      "title": "Paragraph",
      "type": "integer"
    },
    "section_path": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Section Path",
      "type": "array"
    },
    "quote_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Quote Checksum",
      "type": "string"
    },
    "parse_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Parse Checksum",
      "type": "string"
