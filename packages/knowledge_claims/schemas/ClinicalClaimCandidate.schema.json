      "type": "string"
    },
    "authority": {
      "const": "unassessed",
      "default": "unassessed",
      "title": "Authority",
      "type": "string"
    },
    "currency": {
      "const": "unassessed",
      "default": "unassessed",
      "title": "Currency",
      "type": "string"
    },
    "directness": {
      "const": "extractive",
      "default": "extractive",
      "title": "Directness",
      "type": "string"
