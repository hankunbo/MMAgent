      "type": "string"
    },
    "uncertainty": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Uncertainty",
      "type": "array"
    },
    "recommendation_strength": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
