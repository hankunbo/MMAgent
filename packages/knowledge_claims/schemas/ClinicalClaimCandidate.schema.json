      "type": "array"
    },
    "condition": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Condition",
      "type": "array"
    },
    "intervention": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Intervention",
      "type": "array"
    },
    "exam": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Exam",
      "type": "array"
    },
    "modality": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Modality",
      "type": "array"
    },
    "outcome": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Outcome",
      "type": "array"
    },
    "time": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Time",
      "type": "array"
    },
    "laterality": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Laterality",
      "type": "array"
    },
    "device": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Device",
      "type": "array"
    },
    "applicability": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Applicability",
      "type": "array"
    },
    "numbers": {
      "items": {
        "$ref": "#/$defs/NumericEvidence"
