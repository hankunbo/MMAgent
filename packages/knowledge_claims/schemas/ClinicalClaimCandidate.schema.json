      "type": "number"
    },
    "schema_version": {
      "const": "clinical-claim-candidate/1.0.0",
      "default": "clinical-claim-candidate/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "code": {
      "pattern": "^CLAIM:CANDIDATE:[A-F0-9]{64}$",
      "title": "Code",
      "type": "string"
    },
    "version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Version",
      "type": "string"
    },
    "status": {
      "const": "draft",
