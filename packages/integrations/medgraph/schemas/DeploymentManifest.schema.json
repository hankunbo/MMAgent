{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "content_checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Checksum",
          "type": "string"
        },
        "gaps": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Gaps",
          "type": "array"
        },
        "implementation_id": {
          "title": "Implementation Id",
          "type": "integer"
        },
        "implementation_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Key",
          "type": "string"
        },
        "implementation_ref": {
          "$ref": "#/$defs/Ref"
        },
        "native_version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Native Version",
          "type": "string"
        },
        "tool_code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Code",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "integer"
        },
        "tool_ref": {
          "$ref": "#/$defs/Ref"
        },
        "tool_version_id": {
          "title": "Tool Version Id",
          "type": "integer"
        }
      },
      "required": [
        "tool_code",
        "native_version",
        "implementation_key",
        "tool_id",
        "tool_version_id",
        "implementation_id",
        "tool_ref",
        "implementation_ref",
        "content_checksum",
        "gaps"
      ],
      "title": "Binding",
      "type": "object"
    },
    "Invocation": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "shell": {
          "const": false,
          "title": "Shell",
          "type": "boolean"
        },
        "timeout_seconds": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "shell",
        "argv",
        "timeout_seconds"
      ],
      "title": "Invocation",
      "type": "object"
    },
    "JsonValue": {},
    "ManifestResource": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Byte Size"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "resource_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Key",
          "type": "string"
        },
        "resource_role": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Resource Role",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "uri": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "resource_key",
        "resource_role",
        "uri",
        "sha256",
        "byte_size",
        "required",
        "metadata"
      ],
      "title": "ManifestResource",
      "type": "object"
    },
    "NativeManifest": {
      "additionalProperties": false,
      "description": "Exactly the public SQL function result: deliberately no enabled or ports.",
      "properties": {
        "capability_kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Capability Kind",
          "type": "string"
        },
        "entrypoint_uri": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Entrypoint Uri",
          "type": "string"
        },
        "formula_spec": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Formula Spec"
        },
        "hardware_requirements": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Hardware Requirements",
          "type": "object"
        },
        "implementation_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Key",
          "type": "string"
        },
        "implementation_kind": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Implementation Kind",
          "type": "string"
        },
        "invocation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Invocation",
          "type": "object"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provenance",
          "type": "object"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ManifestResource"
          },
          "maxItems": 128,
          "title": "Resources",
          "type": "array"
        },
        "runtime_environment": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Runtime Environment",
          "type": "object"
        },
        "tool_code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Code",
          "type": "string"
        },
        "tool_name_zh": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Name Zh",
          "type": "string"
        },
        "validation_report": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Validation Report",
          "type": "object"
        },
        "validation_status": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Validation Status",
          "type": "string"
        },
        "version": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "working_directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Working Directory"
        }
      },
      "required": [
        "tool_code",
        "tool_name_zh",
        "capability_kind",
        "version",
        "implementation_key",
        "implementation_kind",
        "entrypoint_uri",
        "working_directory",
        "runtime_environment",
        "invocation",
        "formula_spec",
        "hardware_requirements",
        "provenance",
        "resources",
        "validation_status",
        "validation_report"
      ],
      "title": "NativeManifest",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_id": {
          "exclusiveMinimum": 0,
          "title": "Artifact Type Id",
          "type": "integer"
        },
        "cardinality_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cardinality Max"
        },
        "cardinality_min": {
          "minimum": 0,
          "title": "Cardinality Min",
          "type": "integer"
        },
        "constraints": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Constraints",
          "type": "object"
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "exclusiveMinimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "port_name": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Port Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "tool_version_id": {
          "exclusiveMinimum": 0,
          "title": "Tool Version Id",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "tool_version_id",
        "direction",
        "port_name",
        "artifact_type_id",
        "required",
        "cardinality_min",
        "cardinality_max",
        "constraints"
      ],
      "title": "Port",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mapping",
            "policy",
            "catalog",
            "artifact",
            "capability",
            "tool",
            "implementation",
            "workflow",
            "evidence_requirement",
            "clinical_claim",
            "release",
            "template",
            "source_version",
            "applicability_condition",
            "estimate",
            "validation_rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code",
        "version",
        "checksum"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "catalog_ref": {
      "$ref": "#/$defs/Ref"
    },
    "checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "config_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Config Checksum",
      "type": "string"
    },
    "execution_authorized": {
      "const": false,
      "default": false,
      "title": "Execution Authorized",
      "type": "boolean"
    },
    "implementation_ref": {
      "$ref": "#/$defs/Ref"
    },
    "invocation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Invocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/NativeManifest"
        },
        {
          "type": "null"
        }
      ]
    },
    "native_manifest_state": {
      "enum": [
        "visible",
        "disabled_in_native_function"
      ],
      "title": "Native Manifest State",
      "type": "string"
    },
    "parameter_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parameter Schema"
    },
    "policy_checksum": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Checksum",
      "type": "string"
    },
    "ports": {
      "items": {
        "$ref": "#/$defs/Port"
      },
      "maxItems": 64,
      "title": "Ports",
      "type": "array"
    },
    "postprocessing_policy": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Postprocessing Policy"
    },
    "preprocessing_policy": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Preprocessing Policy"
    },
    "schema_version": {
      "const": "medgraph-deployment/1.0.0",
      "default": "medgraph-deployment/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_ref": {
      "$ref": "#/$defs/Ref"
    }
  },
  "required": [
    "checksum",
    "catalog_ref",
    "tool_ref",
    "implementation_ref",
    "binding",
    "native_manifest",
    "invocation",
    "parameter_schema",
    "preprocessing_policy",
    "postprocessing_policy",
    "native_manifest_state",
    "ports",
    "config_checksum",
    "policy_checksum"
  ],
  "title": "DeploymentManifest",
  "type": "object"
}
