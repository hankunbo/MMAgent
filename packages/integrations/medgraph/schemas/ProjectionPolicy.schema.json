    "status_policy": {
      "const": "legacy-conservative/1.0.0",
      "default": "legacy-conservative/1.0.0",
      "title": "Status Policy",
      "type": "string"
    },
    "version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "ProjectionPolicy",
  "type": "object"
}
