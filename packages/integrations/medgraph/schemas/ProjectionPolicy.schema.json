          "type": "string"
        },
        "source_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "tool_code": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Tool Code",
          "type": "string"
        }
      },
      "required": [
        "tool_code",
        "source_path",
        "source_checksum",
        "excerpt",
        "intended_use"
      ],
      "title": "UseDeclaration",
      "type": "object"
