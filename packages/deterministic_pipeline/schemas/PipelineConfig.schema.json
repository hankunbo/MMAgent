      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_ref": {
      "$ref": "#/$defs/Ref"
    },
    "checksum": {
      "title": "Checksum",
      "type": "string"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalContext"
        },
        {
          "$ref": "#/$defs/ResearchRetrievalContext"
        }
      ],
      "title": "Context"
    },
    "grounding": {
      "$ref": "#/$defs/QueryConfig"
    },
    "mapping_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Ref"
      },
      "title": "Mapping Refs",
      "type": "array"
    },
    "pack_ref": {
      "$ref": "#/$defs/VersionedReference"
    },
    "policy": {
      "$ref": "#/$defs/PipelinePolicy"
    },
    "query": {
      "maxLength": 256,
      "title": "Query",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/IndexConfig"
    },
    "service_refs": {
      "items": {
        "$ref": "#/$defs/VersionedReference"
      },
      "minItems": 1,
      "title": "Service Refs",
      "type": "array"
    },
    "version": {
      "default": "case-pipeline-config/1.0.0",
      "enum": [
        "case-pipeline-config/1.0.0",
        "case-pipeline-config/2.0.0"
      ],
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "checksum",
    "pack_ref",
    "catalog_ref",
    "context",
    "query",
    "retrieval",
    "grounding",
    "policy",
    "service_refs"
  ],
  "title": "PipelineConfig",
  "type": "object"
}
