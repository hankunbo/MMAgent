{
  "$defs": {
    "ActorType": {
      "enum": [
        "PLANNER",
        "TRACE_AGENT",
        "TOOL_AGENT",
        "VERIFICATION_AGENT",
        "EXPERT_AGENT",
        "RULE_ENGINE",
        "GRAPH_ENGINE"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_type_code": {
          "title": "Artifact Type Code",
          "type": "string"
        },
        "asset_code": {
          "title": "Asset Code",
          "type": "string"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "contract_type": {
          "const": "Artifact",
          "title": "Contract Type",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "dimensions": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 5,
          "title": "Dimensions",
          "type": "array"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "media_type": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
          "title": "Media Type",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "qc_status": {
          "$ref": "#/$defs/QCStatus"
        },
        "research_only": {
          "title": "Research Only",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ScopeReference"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "uri": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "provenance",
        "scope",
        "laterality",
        "coordinate_space",
        "unit",
        "asset_code",
        "artifact_type_code",
        "uri",
        "checksum",
        "media_type",
        "qc_status",
        "research_only"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "CaseBundle": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "case_code": {
          "title": "Case Code",
          "type": "string"
        },
        "contract_type": {
          "const": "CaseBundle",
          "title": "Contract Type",
          "type": "string"
        },
        "coordinate_space": {
          "$ref": "#/$defs/CoordinateSpace"
        },
        "encounter_code": {
          "title": "Encounter Code",
          "type": "string"
        },
        "extensions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Extensions",
          "type": "object"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/GoalRequest"
          },
          "minItems": 1,
          "title": "Goals",
          "type": "array"
        },
        "laterality": {
          "$ref": "#/$defs/Laterality"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructuredObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "patient_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Patient Hash",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "report_uri": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Uri"
        },
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ScopeReference"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "schema_version",
        "contract_type",
        "provenance",
        "scope",
        "laterality",
        "coordinate_space",
        "unit",
        "case_code",
        "patient_hash",
        "encounter_code",
        "goals"
      ],
      "title": "CaseBundle",
      "type": "object"
    },
    "CoordinateSpace": {
      "enum": [
        "PIXEL_2D",
        "VOXEL_3D",
        "PATIENT",
        "SCANNER",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "CoordinateSpace",
      "type": "string"
    },
    "EvidenceObservationStatus": {
      "enum": [
        "UNOBSERVED",
        "POSITIVE",
        "NEGATIVE",
        "INCONCLUSIVE",
        "UNOBSERVED_TOOL_GAP",
        "NOT_APPLICABLE"
      ],
      "title": "EvidenceObservationStatus",
      "type": "string"
    },
    "FieldVisibility": {
      "additionalProperties": false,
      "properties": {
        "derived_requires_review": {
          "default": [],
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Derived Requires Review",
          "type": "array"
        },
        "owner_only": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Owner Only",
          "type": "array"
        },
        "planner_visible": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Planner Visible",
          "type": "array"
        },
        "policy_version": {
          "const": "field-visibility/1.0.0",
          "default": "field-visibility/1.0.0",
          "title": "Policy Version",
          "type": "string"
        },
        "raw_text_redactor_owner": {
          "enum": [
            "07A",
            "none"
          ],
          "title": "Raw Text Redactor Owner",
          "type": "string"
        },
        "unknown_fields": {
          "const": "reject",
          "default": "reject",
          "title": "Unknown Fields",
          "type": "string"
        },
        "withheld": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Withheld",
          "type": "array"
        }
      },
      "required": [
        "planner_visible",
        "withheld",
        "owner_only",
        "raw_text_redactor_owner"
      ],
      "title": "FieldVisibility",
      "type": "object"
    },
    "GoalRequest": {
      "additionalProperties": false,
      "properties": {
        "goal_code": {
          "title": "Goal Code",
          "type": "string"
        },
        "goal_level": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Goal Level",
          "type": "string"
        }
      },
      "required": [
        "goal_code",
        "goal_level"
      ],
      "title": "GoalRequest",
      "type": "object"
    },
    "JsonValue": {},
    "Laterality": {
      "enum": [
        "LEFT",
        "RIGHT",
        "BILATERAL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "Laterality",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorType"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generator_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Generator Version",
          "type": "string"
        },
        "input_checksums": {
          "default": [],
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Input Checksums",
          "type": "array"
        },
        "knowledge_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Knowledge Versions",
          "type": "array"
        },
        "rule_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Rule Versions",
          "type": "array"
        },
        "source_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Codes",
          "type": "array"
        },
        "tool_versions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionedReference"
          },
          "title": "Tool Versions",
          "type": "array"
        }
      },
      "required": [
        "actor",
        "created_at",
        "generator_version",
        "source_codes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "QCStatus": {
      "enum": [
        "UNASSESSED",
        "PENDING",
        "PASS",
        "FAIL"
      ],
      "title": "QCStatus",
      "type": "string"
    },
    "ScopeReference": {
      "additionalProperties": false,
      "properties": {
        "case_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Code"
        },
        "episode_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Code"
        },
        "graph_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graph Code"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "scope_type": {
          "$ref": "#/$defs/ScopeType"
        },
        "step_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "scope_type"
      ],
      "title": "ScopeReference",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "GLOBAL",
        "CASE",
        "RUN",
        "GRAPH",
        "STEP",
        "TOOL_EXTENSION",
        "MEMORY"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "StructuredObservation": {
      "additionalProperties": false,
      "properties": {
        "concept_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Concept Code",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/EvidenceObservationStatus"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "source_code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Source Code",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "pattern": "^(?:1|[A-Za-z%][A-Za-z0-9%*/.^_-]{0,31})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "concept_code",
        "observation",
        "value",
        "unit",
        "source_code"
      ],
      "title": "StructuredObservation",
      "type": "object"
    },
    "VersionedReference": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{1,31}(?::[A-Z0-9][A-Z0-9._-]{0,63})+$",
          "title": "Code",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "version"
      ],
      "title": "VersionedReference",
      "type": "object"
    },
    "VisibleManifest": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "dataset-adapters/1.0.0",
          "default": "dataset-adapters/1.0.0",
          "title": "Adapter Version",
          "type": "string"
        },
        "available_modalities": {
          "items": {
            "enum": [
              "SLO",
              "color_fundus"
            ],
            "type": "string"
          },
          "title": "Available Modalities",
          "type": "array"
        },
        "case": {
          "$ref": "#/$defs/CaseBundle"
        },
        "checksum": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "dataset_ref": {
          "$ref": "#/$defs/VersionedReference"
        },
        "pack_ref": {
          "$ref": "#/$defs/VersionedReference"
        },
        "patient_identity": {
          "enum": [
            "unknown",
            "dataset_local_explicit_id"
          ],
          "title": "Patient Identity",
          "type": "string"
        },
        "patient_independence": {
          "const": "unproven",
          "default": "unproven",
          "title": "Patient Independence",
          "type": "string"
        },
        "schema_version": {
          "const": "visible-input/1.0.0",
          "default": "visible-input/1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "split": {
          "const": "training",
          "default": "training",
          "title": "Split",
          "type": "string"
        },
        "split_contamination_risk": {
          "const": true,
          "default": true,
          "title": "Split Contamination Risk",
          "type": "boolean"
        },
        "text_review": {
          "enum": [
            "pending",
            "not_applicable"
          ],
          "title": "Text Review",
          "type": "string"
        },
        "timepoint": {
          "const": "unknown",
          "default": "unknown",
          "title": "Timepoint",
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/FieldVisibility"
        }
      },
      "required": [
        "checksum",
        "dataset_ref",
        "pack_ref",
        "visibility",
        "case",
        "patient_identity",
        "text_review",
        "available_modalities"
      ],
      "title": "VisibleManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Real case always retains the full VisibleManifest; synthetic input is separate.",
  "properties": {
    "case": {
      "$ref": "#/$defs/CaseBundle"
    },
    "input_checksum": {
      "title": "Input Checksum",
      "type": "string"
    },
    "pack_ref": {
      "$ref": "#/$defs/VersionedReference"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "visible": {
      "anyOf": [
        {
          "$ref": "#/$defs/VisibleManifest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "synthetic",
    "case",
    "pack_ref",
    "input_checksum",
    "visible"
  ],
  "title": "CaseInput",
  "type": "object"
}
